              {
                "kind": "input",
                "prompt": ">>>",
                "text": "import flopscope as flops"
              },
              {
                "kind": "input",
                "prompt": ">>>",
                "text": "import flopscope.numpy as fnp"
              },
              {
                "kind": "input",
                "prompt": ">>>",
                "text": "data = fnp.random.randn(4, 4)"
              },
              {
                "kind": "input",
                "prompt": ">>>",
                "text": "S = flops.symmetrize(data, symmetry=flops.SymmetryGroup.symmetric(axes=(0, 1)))"
              },
              {
                "kind": "input",
                "prompt": ">>>",
                "text": "S.is_symmetric((0, 1))"
              },
              {
                "kind": "output",
                "text": "True"
              }
            ],
            "type": "doctest_block"
          }
        ],
        "title": "Examples"
