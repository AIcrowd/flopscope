      },
      {
        "blocks": [
          {
            "inline": [
              {
                "kind": "code",
                "text": "\"reynolds-projection\""
              },
              {
                "kind": "text",
                "text": " performs exact Reynolds averaging internally,\nbilling "
              },
              {
                "kind": "code",
                "text": "(|G| + 1) * numel(data)"
              },
              {
                "kind": "text",
                "text": " FLOPs:"
              }
            ],
            "type": "paragraph"
          },
          {
            "items": [
              {
                "blocks": [
                  {
                    "inline": [
                      {
                        "kind": "code",
                        "text": "|G|"
                      },
                      {
                        "kind": "text",
                        "text": " transposed add passes over "
                      },
                      {
                        "kind": "code",
                        "text": "numel"
                      },
                      {
                        "kind": "text",
                        "text": " elements"
                      }
                    ],
                    "type": "paragraph"
                  }
                ]
              },
              {
                "blocks": [
                  {
                    "inline": [
                      {
                        "kind": "text",
                        "text": "one final scaling pass (divide by "
                      },
                      {
                        "kind": "code",
                        "text": "|G|"
                      },
                      {
                        "kind": "text",
                        "text": ")"
                      }
                    ],
                    "type": "paragraph"
                  }
                ]
              }
            ],
            "ordered": false,
            "type": "list"
          },
          {
            "inline": [
              {
                "kind": "text",
                "text": "Internal validation runs but is NOT billed (decision D1)."
              }
            ],
            "type": "paragraph"
          },
          {
            "inline": [
              {
                "kind": "text",
                "text": "where "
              },
              {
                "kind": "code",
                "text": "|G|"
              },
              {
                "kind": "text",
                "text": " is the group order and "
              },
              {
                "kind": "code",
                "text": "numel = data.size"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "type": "paragraph"
          },
          {
            "inline": [
              {
                "kind": "code",
                "text": "\"canonical-copy\""
              },
              {
                "kind": "text",
                "text": " bills "
              },
              {
                "kind": "code",
                "text": "numel(data)"
              },
              {
                "kind": "text",
                "text": " -- one write per output\nelement, the same rate as every other materializing copy ("
              },
              {
                "external_url": "",
                "href": "/docs/api/numpy/copy/",
                "kind": "link",
                "target": "copy",
                "text": "copy"
              },
              {
                "kind": "text",
                "text": ",\n"
              },
              {
                "external_url": "",
                "href": "/docs/api/numpy/take/",
                "kind": "link",
                "target": "take",
                "text": "take"
              },
              {
                "kind": "text",
                "text": ", "
              },
              {
                "external_url": "",
                "href": "/docs/api/numpy/repeat/",
                "kind": "link",
                "target": "repeat",
                "text": "repeat"
              },
              {
                "kind": "text",
                "text": "). It needs no validation pass because its output is\ninvariant by construction, and it never enumerates "
              },
              {
                "kind": "code",
                "text": "|G|"
              },
              {
                "kind": "text",
                "text": ": the orbit map\nis built from the group's generators and cached per\n"
              },
              {
                "kind": "code",
                "text": "(shape, group action)"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "type": "paragraph"
          },
          {
            "inline": [
              {
                "kind": "text",
                "text": "The two modes also differ in dtype. Averaging must divide, so\n"
              },
              {
                "kind": "code",
                "text": "\"reynolds-projection\""
              },
              {
                "kind": "text",
                "text": " accumulates in\n"
              },
              {
                "kind": "code",
                "text": "result_type(data, float64)"
              },
              {
                "kind": "text",
                "text": " -- a "
              },
              {
                "kind": "code",
                "text": "float32"
              },
              {
                "kind": "text",
                "text": " input comes back\n"
              },
              {
                "kind": "code",
                "text": "float64"
              },
              {
                "kind": "text",
                "text": ". "
              },
              {
                "kind": "code",
                "text": "\"canonical-copy\""
              },
              {
                "kind": "text",
                "text": " only moves values, so it preserves the\ninput dtype exactly, including integer, boolean and complex types."
              }
            ],
            "type": "paragraph"
          },
          {
            "inline": [
              {
                "kind": "text",
                "text": "The canonical pattern for generating random data with symmetry is:"
              }
            ],
            "type": "paragraph"
          },
          {
            "inline": [
              {
                "kind": "code",
                "text": "fnp.random.symmetric(shape, symmetry_group, distribution=...)"
              },
              {
                "kind": "text",
                "text": "."
              }
            ],
            "type": "paragraph"
          }
        ],
        "title": "Notes"
      },
