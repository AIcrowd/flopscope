ment/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"Random"},"295":{"id":"/docs/development/contributing-169","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"`numpy.random.tests.test_random`"},"296":{"id":"/docs/development/contributing-170","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"0 (module skipped)"},"297":{"id":"/docs/development/contributing-171","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"—"},"298":{"id":"/docs/development/contributing-172","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"**Total**"},"299":{"id":"/docs/development/contributing-173","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"**5,275**"},"300":{"id":"/docs/development/contributing-174","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"**329**"},"301":{"id":"/docs/development/contributing-175","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"Three suites fail to *import* rather than run any of their own tests, and are counted as\nfully skipped: `test_numeric` builds a non-numeric-dtype array at module import time, which\nthe dtype ban refuses; `test_linalg` and `test_random` each mutate an array at\nmodule import time, which flopscope's immutable arrays refuse. Each of these collection\nfailures is caught and reported as a single module-level skip rather than failing the\nrun — see `pytest_make_collect_report` in `tests/numpy_compat/conftest.py`."},"302":{"id":"/docs/development/contributing-176","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"All other failures are tracked as xfails in `tests/numpy_compat/xfails.py`."},"303":{"id":"/docs/development/contributing-177","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#running-the-tests","content":"Tests use `pytest-xdist` for parallel execution across all CPU cores."},"304":{"id":"/docs/development/contributing-178","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#running-the-tests","content":"The numpy\\_compat tests are excluded from the default `pytest` run (via `pyproject.toml` `addopts`) to prevent the monkeypatch from contaminating the main test suite. They run as a separate step in CI."},"305":{"id":"/docs/development/contributing-179","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Tests that fail due to known, accepted differences are tracked in `tests/numpy_compat/xfails.py`. Each entry maps a test pattern to a categorized reason. As measured on numpy 2.2.6:"},"306":{"id":"/docs/development/contributing-180","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Category"},"307":{"id":"/docs/development/contributing-181","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Count"},"308":{"id":"/docs/development/contributing-182","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Meaning"},"309":{"id":"/docs/development/contributing-183","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`SUBCLASS_RETURN`"},"310":{"id":"/docs/development/contributing-184","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"26"},"311":{"id":"/docs/development/contributing-185","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"A patched op returns/propagates `FlopscopeArray` where the test expects a plain `ndarray` or scalar"},"312":{"id":"/docs/development/contributing-186","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`NONNUMERIC_DTYPE_BANNED`"},"313":{"id":"/docs/development/contributing-187","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"21"},"314":{"id":"/docs/development/contributing-188","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"The dtype ban (a numeric allowlist: bool, integer, float, complex) refuses a non-numeric-dtype array — object, string, bytes, structured/void, datetime64, or timedelta64 — the test constructs or requires directly"},"315":{"id":"/docs/development/contributing-189","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`NEEDS_TRIAGE`"},"316":{"id":"/docs/development/contributing-190","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"16"},"317":{"id":"/docs/development/contributing-191","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Passes in isolation but fails under the parametrize sweep — order-dependent state pollution, not yet root-caused"},"318":{"id":"/docs/development/contributing-192","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`NOT_IMPLEMENTED`"},"319":{"id":"/docs/development/contributing-193","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"11"},"320":{"id":"/docs/development/contributing-194","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Function exists but lacks a kwarg or edge case (missing `out=`, `where=`, `subok=`, …)"},"321":{"id":"/docs/development/contributing-195","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`NUMPY_INTERNAL`"},"322":{"id":"/docs/development/contributing-196","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"1"},"323":{"id":"/docs/development/contributing-197","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"Test uses numpy internals (`_umath_tests`, internal type tables)"},"324":{"id":"/docs/development/contributing-198","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`UPSTREAM_NUMPY_FLAKE`"},"325":{"id":"/docs/development/contributing-199","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"1"},"326":{"id":"/docs/development/contributing-200","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"A numpy-side tolerance/precision flake unrelated to flopscope"},"327":{"id":"/docs/development/contributing-201","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`BY_DESIGN`"},"328":{"id":"/docs/development/contributing-202","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"1"},"329":{"id":"/docs/development/contributing-203","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"flopscope intentionally diverges from numpy's behavior here"},"330":{"id":"/docs/development/contributing-204","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"immutability"},"331":{"id":"/docs/development/contributing-205","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"1"},"332":{"id":"/docs/development/contributing-206","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"flopscope arrays are immutable; the test mutates one in place"},"333":{"id":"/docs/development/contributing-207","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#known-divergences-xfails","content":"`test_numeric`, `test_linalg`, and `test_random` no longer contribute xfails to this table at\nall — all three suites fail to *import* on this numpy version (see Test\nsuites above), so none of their individual tests are collected."},"334":{"id":"/docs/development/contributing-208","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#triaging-new-failures","content":"Run a suite: `uv run pytest tests/numpy_compat/ --pyargs <module> -n auto --tb=line`"},"335":{"id":"/docs/development/contributing-209","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#triaging-new-failures","content":"Categorize each failure"},"336":{"id":"/docs/development/contributing-210","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#triaging-new-failures","content":"If it's a bug we should fix, create an issue"},"337":{"id":"/docs/development/contributing-211","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#triaging-new-failures","content":"If it's an accepted divergence, add it to `xfails.py`"},"338":{"id":"/docs/development/contributing-212","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#why-monkeypatching-not-subclassing","content":"We considered alternatives:"},"339":{"id":"/docs/development/contributing-213","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#why-monkeypatching-not-subclassing","content":"**Array subclass with `__array_ufunc__`**: Would intercept ufunc calls, but flopscope arrays are plain `numpy.ndarray` by design -- no custom tensor class."},"340":{"id":"/docs/development/contributing-214","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#why-monkeypatching-not-subclassing","content":"**Running tests with `import flopscope as np`**: NumPy's test files import from `numpy._core`, `numpy.testing`, etc. -- can't redirect all internal imports."},"341":{"id":"/docs/development/contributing-215","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#why-monkeypatching-not-subclassing","content":"**Monkeypatching with frozen numpy**: Simple, works with NumPy's existing test infrastructure, tests exactly what users experience (same function signatures), and the frozen-numpy trick prevents infinite recursion."},"342":{"id":"/docs/development/contributing-216","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#related-pages","content":"Running with Docker — containerized client-server setup"},"343":{"id":"/docs/development/contributing-217","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#related-pages","content":"Client-Server Model — architecture overview"},"344":{"id":"/docs/development/release","page_id":"/docs/development/release","type":"page","content":"Release Process","breadcrumbs":["Documentation","Development"],"tags":[],"url":"/docs/development/release"},"345":{"id":"/docs/development/release-0","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#version-bumps","content":"Version bumps"},"346":{"id":"/docs/development/release-1","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#end-to-end-flow","content":"End-to-end flow"},"347":{"id":"/docs/development/release-2","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#multi-package-lockstep","content":"Multi-package lockstep"},"348":{"id":"/docs/development/release-3","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"What happens after `git push --follow-tags`"},"349":{"id":"/docs/development/release-4","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"First-time PyPI setup (one-time per project)"},"350":{"id":"/docs/development/release-5","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#manual-publish-from-a-maintainers-machine-fallback","content":"Manual publish from a maintainer's machine (fallback)"},"351":{"id":"/docs/development/release-6","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#one-time-setup","content":"One-time setup"},"352":{"id":"/docs/development/release-7","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#publishing-vxyz-manually","content":"Publishing v<X.Y.Z> manually"},"353":{"id":"/docs/development/release-8","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#trade-offs-vs-the-workflow","content":"Trade-offs vs the workflow"},"354":{"id":"/docs/development/release-9","page_id":"/docs/development/release","type":"heading","tags":[],"url":"/docs/development/release#related-references","content":"Related references"},"355":{"id":"/docs/development/release-10","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"*Use this page when cutting a new release of flopscope.*"},"356":{"id":"/docs/development/release-11","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"**You will learn:**"},"357":{"id":"/docs/development/release-12","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"How commit types map to version bumps under semver"},"358":{"id":"/docs/development/release-13","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"How `cz bump` updates versions across the three packages and tags"},"359":{"id":"/docs/development/release-14","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"What happens after `git push --follow-tags`"},"360":{"id":"/docs/development/release-15","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"The one-time PyPI Trusted Publisher setup per project"},"361":{"id":"/docs/development/release-16","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Versions follow Semantic Versioning. While at `0.x`, the project is\nAPI-unstable — breaking changes bump the **minor** digit, not the major.\nCommit types map to bumps as follows:"},"362":{"id":"/docs/development/release-17","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Commit type"},"363":{"id":"/docs/development/release-18","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`0.x` bump"},"364":{"id":"/docs/development/release-19","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`≥1.0` bump"},"365":{"id":"/docs/development/release-20","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`fix:`"},"366":{"id":"/docs/development/release-21","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"patch (`0.2.0` → `0.2.1`)"},"367":{"id":"/docs/development/release-22","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"patch"},"368":{"id":"/docs/development/release-23","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`feat:`"},"369":{"id":"/docs/development/release-24","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"minor (`0.2.0` → `0.3.0`)"},"370":{"id":"/docs/development/release-25","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"minor"},"371":{"id":"/docs/development/release-26","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`feat!:` / `BREAKING CHANGE:`"},"372":{"id":"/docs/development/release-27","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"minor (`0.2.0` → `0.3.0`)"},"373":{"id":"/docs/development/release-28","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"**major** (`1.4` → `2.0`)"},"374":{"id":"/docs/development/release-29","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Other types (`chore`, `docs`, …)"},"375":{"id":"/docs/development/release-30","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"no release"},"376":{"id":"/docs/development/release-31","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"no release"},"377":{"id":"/docs/development/release-32","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Commitizen handles this automatically via `major_version_zero = true` in\nthe `[tool.commitizen]` block of `pyproject.toml`. Flip that to `false`\nwhen we cut `v1.0.0`."},"378":{"id":"/docs/development/release-33","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#end-to-end-flow","content":"We release with commitizen.\nEnd-to-end flow:"},"379":{"id":"/docs/development/release-34","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#end-to-end-flow","content":"Why not plain `uv run cz bump`? It commits and tags in one shot, *before*\nthe lockfiles can be refreshed — so the bump commit ships stale `uv.lock`\nfiles and `check-lock` fails on main. If you ran it anyway: `make relock`,\nthen stage the three lockfiles (`git add uv.lock flopscope-server/uv.lock\nflopscope-client/uv.lock`) — an unstaged `--amend` would silently exclude\nthem — then `git commit --amend --no-edit`, and re-point the tag with\n`git tag -fa v<new> -m \"v<new>\"` before pushing."},"380":{"id":"/docs/development/release-35","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#end-to-end-flow","content":"Pre-releases follow the same files-only flow with `--prerelease alpha`\nadded in step 3 (`uv run cz bump --files-only --changelog --prerelease\nalpha`); the relock, verify, commit, and tag steps are identical, with\nthe prerelease version to tag (e.g. `v0.3.0a0`) shown in the bump\noutput."},"381":{"id":"/docs/development/release-36","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"`flopscope`, `flopscope-server`, and `flopscope-client` are released in\nlockstep at the same version. `cz bump` updates **all** version\nlocations in one invocation via the `version_files` config in\n`[tool.commitizen]`:"},"382":{"id":"/docs/development/release-37","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"All three `pyproject.toml` `[project].version` fields"},"383":{"id":"/docs/development/release-38","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"All three `__version__` strings in package `__init__.py` files"},"384":{"id":"/docs/development/release-39","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"Both cross-package pins (`flopscope-server==X.Y.Z` in flopscope's\n`server` extra, and `flopscope==X.Y.Z` in flopscope-server's\n`dependencies`)"},"385":{"id":"/docs/development/release-40","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"Before tagging, `check-sync-versions` asserts that all eight version\nlocations agree. Run locally:"},"386":{"id":"/docs/development/release-41","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"CI runs this in the `client-server-sync` job on every PR, so drift\nintroduced by hand-edits is caught before merge."},"387":{"id":"/docs/development/release-42","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"The tag push triggers\n`.github/workflows/pypi-publish.yml`,\nwhich:"},"388":{"id":"/docs/development/release-43","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Builds wheels in parallel via a matrix job — one per published\npackage."},"389":{"id":"/docs/development/release-44","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Pauses for approval in the `pypi` GitHub environment (manual gate).\nA single approval click covers all matrix-publish jobs."},"390":{"id":"/docs/development/release-45","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Publishes the packages to PyPI in parallel via Trusted Publishing\n(OIDC; no API token stored in repo secrets)."},"391":{"id":"/docs/development/release-46","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Creates one GitHub Release whose body is the matching CHANGELOG\nsection for that tag."},"392":{"id":"/docs/development/release-47","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"End result: `pip install <package>==X.Y.Z` works \\~2 minutes after a\nmaintainer clicks \"approve\" on the `pypi` environment gate."},"393":{"id":"/docs/development/release-48","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Before the first release will succeed, configure two things outside the\nrepo. The Trusted Publisher steps must be repeated for **each** PyPI\nproject name being published."},"394":{"id":"/docs/development/release-49","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"**On PyPI — add a Trusted Publisher (do this for each project name):**"},"395":{"id":"/docs/development/release-50","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Go to https\\://pypi.org/manage/account/publishing/"},"396":{"id":"/docs/development/release-51","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Click \"Add a new pending publisher\""},"397":{"id":"/docs/development/release-52","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Fill in (repeat with each project name in turn):"},"398":{"id":"/docs/development/release-53","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"PyPI Project Name: `flopscope`, then `flopscope-server`, then\n`flopscope-client`"},"399":{"id":"/docs/development/release-54","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Owner: `AIcrowd`"},"400":{"id":"/docs/development/release-55","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Repository name: `flopscope`"},"401":{"id":"/docs/development/release-56","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Workflow name: `pypi-publish.yml`"},"402":{"id":"/docs/development/release-57","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Environment name: `pypi`"},"403":{"id":"/docs/development/release-58","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Save each one."},"404":{"id":"/docs/development/release-59","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"**On GitHub — create the `pypi` environment with required reviewers\n(do this once; it is shared across all matrix-publish jobs):**"},"405":{"id":"/docs/development/release-60","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Go to https\\://github.com/AIcrowd/flopscope/settings/environments"},"406":{"id":"/docs/development/release-61","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Click \"New environment\", name it `pypi`"},"407":{"id":"/docs/development/release-62","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Under \"Deployment protection rules\" → \"Required reviewers\", add the\nrelease maintainers"},"408":{"id":"/docs/development/release-63","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Save"},"409":{"id":"/docs/development/release-64","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"After all configured Trusted Publishers and the shared environment are\nset up, the next `v*` tag push will trigger the publish flow\nend-to-end — and a single approval click covers all matrix publishes."},"410":{"id":"/docs/development/release-65","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#manual-publish-from-a-maintainers-machine-fallback","content":"The normal path is the matrix workflow described above. Use this section only\nwhen GitHub Actions is unavailable or won't fire (Actions outage, repo policy\nglitch, etc.) and you need to ship a release right now. This path bypasses\nTrusted Publishing, the `pypi` environment approval gate, and the auto-created\nGitHub Release."},"411":{"id":"/docs/development/release-66","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Install `twine` as a uv-managed tool\n(keeps it out of project dependencies):"},"412":{"id":"/docs/development/release-67","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Generate three **project-scoped** PyPI API tokens, one per project. For\neach of `flopscope`, `flopscope-server`, `flopscope-client`:"},"413":{"id":"/docs/development/release-68","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Go to https\\://pypi.org/manage/account/token/"},"414":{"id":"/docs/development/release-69","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Click \"Add API token\""},"415":{"id":"/docs/development/release-70","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"**Token name:** something self-descriptive (e.g. `flopscope-manual-2026`)"},"416":{"id":"/docs/development/release-71","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"**Scope:** \"Project: flopscope\" (scope to a single project — not \"Entire account\")"},"417":{"id":"/docs/development/release-72","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Copy the `pypi-...` token immediately; PyPI will not show it again"},"418":{"id":"/docs/development/release-73","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Add all three tokens to `~/.pypirc` (chmod 600 the file). Per-project\nsections let twine pick the right one based on the wheel's distribution\nname:"},"419":{"id":"/docs/development/release-74","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Assumes the bump commit + `vX.Y.Z` tag already exist on `main` (produce\nthem with the End-to-end flow above as usual; the\ndifference is only that the GH workflow won't run)."},"420":{"id":"/docs/development/release-75","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Build all three packages from the tagged commit:"},"421":{"id":"/docs/development/release-76","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Verify each wheel's metadata is what you expect — particularly the\n`Requires-Dist` cross-pin in flopscope-server and the `Provides-Extra: server`\nin flopscope:"},"422":{"id":"/docs/development/release-77","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Upload each wheel + sdist with `twine`, pointing at the per-project section\nof `~/.pypirc`:"},"423":{"id":"/docs/development/release-78","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Twine prints a https\\://pypi.org/project/.../ URL after each successful\nupload. If a previous attempt already uploaded any of the files, add\n`--skip-existing` to make the command idempotent."},"424":{"id":"/docs/development/release-79","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Create the GitHub Release manually (the workflow would normally do this):"},"425":{"id":"/docs/development/release-80","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"The manual path skips four safety nets the workflow gives you:"},"426":{"id":"/docs/development/release-81","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Environment approval gate.** Anyone with the API tokens can publish; there\nis no second-pair-of-eyes click. Scope tokens narrowly and rotate them after\nuse if leaked or no longer needed."},"427":{"id":"/docs/development/release-82","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Trusted Publishing audit trail.** PyPI records \"uploaded by API token X\"\ninstead of \"uploaded by GH workflow run #...\" — harder to trace."},"428":{"id":"/docs/development/release-83","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Auto-generated GitHub Release with notes from CHANGELOG.** Step 4 above\nis the manual replacement."},"429":{"id":"/docs/development/release-84","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Matrix isolation.** Network/IO failures during upload could leave a\npartial publish (e.g., flopscope uploaded but flopscope-server failed).\nIn that case re-run only the failed `twine upload` with `--skip-existing`."},"430":{"id":"/docs/development/release-85","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"Once Actions is healthy again, **switch back to the workflow path** — delete\nthe API tokens you created for the manual publish, and the next `vX.Y.Z` tag\npush will go through Trusted Publishing as normal."},"431":{"id":"/docs/development/release-86","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#related-references","content":"`[tool.commitizen]` in pyproject.toml — release tooling config"},"432":{"id":"/docs/development/release-87","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#related-references","content":"`.github/workflows/pypi-publish.yml` — the publish workflow"},"433":{"id":"/docs/development/release-88","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#related-references","content":"`scripts/check_version_sync.py` — version-sync checker"},"434":{"id":"/docs/development/release-89","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#related-references","content":"Contributor Guide — repo layout, dev setup, commit conventions, `commit-msg` hook"},"435":{"id":"/docs/getting-started/competition","page_id":"/docs/getting-started/competition","type":"page","content":"Competition Guide","breadcrumbs":["Documentation","Getting Started"],"tags":[],"url":"/docs/getting-started/competition"},"436":{"id":"/docs/getting-started/competition-0","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#setting-a-flop-budget","content":"Setting a FLOP budget"},"437":{"id":"/docs/getting-started/competition-1","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#decorator-form","content":"Decorator form"},"438":{"id":"/docs/getting-started/competition-2","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#wall-time-limits","content":"Wall-time limits"},"439":{"id":"/docs/getting-started/competition-3","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Reading the budget summary"},"440":{"id":"/docs/getting-started/competition-4","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#quick-tips-for-competition","content":"Quick tips for competition"},"441":{"id":"/docs/getting-started/competition-5","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#local-vs-remote-backends","content":"Local vs. remote backends"},"442":{"id":"/docs/getting-started/competition-6","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#immutable-arrays","content":"Immutable arrays"},"443":{"id":"/docs/getting-started/competition-7","page_id":"/docs/getting-started/competition","type":"heading","tags":[],"url":"/docs/getting-started/competition#when-things-go-wrong","content":"When things go wrong"},"444":{"id":"/docs/getting-started/competition-8","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"*Everything you need to compete within a FLOP budget.*"},"445":{"id":"/docs/getting-started/competition-9","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"**You will learn:**"},"446":{"id":"/docs/getting-started/competition-10","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"How to set budget limits with `BudgetContext`"},"447":{"id":"/docs/getting-started/competition-11","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"How to use the `@flops.budget` decorator form"},"448":{"id":"/docs/getting-started/competition-12","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"How wall-time limits work via `wall_time_limit_s`"},"449":{"id":"/docs/getting-started/competition-13","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"How to read budget summaries"},"450":{"id":"/docs/getting-started/competition-14","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition","content":"Common competition pitfalls and tips"},"451":{"id":"/docs/getting-started/competition-15","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#setting-a-flop-budget","content":"Every competition submission runs inside a FLOP budget. Use `BudgetContext` to declare how many FLOPs your code is allowed to spend:"},"452":{"id":"/docs/getting-started/competition-16","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#setting-a-flop-budget","content":"If your code exceeds the budget, Flopscope raises `BudgetExhaustedError` *before* the offending operation executes. The error message includes the cost of the failed operation and the remaining budget."},"453":{"id":"/docs/getting-started/competition-17","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#setting-a-flop-budget","content":"The `namespace` parameter sets the root namespace prefix for that budget context. Nested `fnp.namespace(...)` scopes extend it with dotted segments, but they do not create child budgets or split the FLOP limit into separate pools."},"454":{"id":"/docs/getting-started/competition-18","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#decorator-form","content":"For cleaner code, use `@flops.budget` to attach a budget directly to a function:"},"455":{"id":"/docs/getting-started/competition-19","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#decorator-form","content":"Each call to the decorated function runs inside the same `BudgetContext`; the namespace is only the root prefix used for attribution, not a separate budget pool. Repeated calls reuse that context and keep accumulating on the same budget and operation log."},"456":{"id":"/docs/getting-started/competition-20","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"In addition to FLOP budgets, competitions may enforce a wall-clock time limit via `wall_time_limit_s`. This prevents solutions from stalling on operations that are analytically cheap but slow in practice:"},"457":{"id":"/docs/getting-started/competition-21","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"If the wall-clock time is exceeded, Flopscope raises `TimeExhaustedError`. The timer starts when the context is entered and is checked after each counted operation."},"458":{"id":"/docs/getting-started/competition-22","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"What `wall_time_limit_s` does and does not do:"},"459":{"id":"/docs/getting-started/competition-23","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"It is a `BudgetContext` setting, so you configure it in the same place you set `flop_budget`."},"460":{"id":"/docs/getting-started/competition-24","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"It measures total wall-clock time for the active context, not FLOPs."},"461":{"id":"/docs/getting-started/competition-25","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"It is checked cooperatively before and after counted NumPy calls, so overshoot is bounded by the duration of one NumPy call."},"462":{"id":"/docs/getting-started/competition-26","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#wall-time-limits","content":"It is a clean diagnostic limit inside flopscope. Hard process/container kills still belong to the outer execution environment."},"463":{"id":"/docs/getting-started/competition-27","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Call `budget.summary()` when you want the current context's summary, or `flops.budget_summary()` for the accumulated session/global view. Both stay flat by default; use `by_namespace=True` only when you want a namespace breakdown:"},"464":{"id":"/docs/getting-started/competition-28","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Use these forms for different questions:"},"465":{"id":"/docs/getting-started/competition-29","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"`budget.summary()` answers \"what did this one explicit context spend?\""},"466":{"id":"/docs/getting-started/competition-30","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"`flops.budget_summary()` answers \"what has this process/session spent overall?\""},"467":{"id":"/docs/getting-started/competition-31","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"`budget.summary_dict(...)` and `flops.budget_summary_dict(...)` return the same information as structured data instead of formatted text."},"468":{"id":"/docs/getting-started/competition-32","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"The block below shows `print(budget.summary(by_namespace=True))` for the `solver` context:"},"469":{"id":"/docs/getting-started/competition-33","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Key things to look for:"},"470":{"id":"/docs/getting-started/competition-34","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"**Budget / Used / Remaining:** the top rows show the explicit competition budget, current spend, and remaining headroom"},"471":{"id":"/docs/getting-started/competition-35","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"**By namespace:** `solver` is the root prefix, and nested scopes show up as dotted paths like `solver.precompute`. Use `budget.summary(by_namespace=True)` for the current context or `flops.budget_summary(by_namespace=True)` for the accumulated session/global view"},"472":{"id":"/docs/getting-started/competition-36","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"**By operation:** this toy pass is dominated by the single `einsum`; `exp` and `sum` are tiny by comparison"},"473":{"id":"/docs/getting-started/competition-37","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"**Wall / backend / flopscope overhead / residual time:** wall time is total elapsed time for the context. Flopscope backend time is spent inside the underlying NumPy / BLAS / LAPACK calls being counted (including data-movement ops like `tile`, `take`, `pad`). Flopscope overhead is spent in flopscope's own dispatch code (wrapper preambles, FLOP cost computation, view-casts, post-call wrapping, `maybe_check_nan_inf` when opted in). Residual wall time is the measured remainder outside backend calls and flopscope overhead (user Python between ops, sleeps, GC pauses, and the callback time of ops like `apply_along_axis`). The decomposition is exact: `wall_time_s = flopscope_backend_time_s + flopscope_overhead_time_s + residual_wall_time_s`"},"474":{"id":"/docs/getting-started/competition-38","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"**Flat default:** the default summary stays flat unless you opt into `by_namespace=True`"},"475":{"id":"/docs/getting-started/competition-39","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"For programmatic access, use `flops.budget_summary_dict()`:"},"476":{"id":"/docs/getting-started/competition-40","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Local and remote summary dictionaries have the same public schema and\naccounting meaning. During evaluation, the remote global summary is a read-only\nsnapshot of authoritative server state."},"477":{"id":"/docs/getting-started/competition-41","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"The one-participant-process epoch is a WHEST evaluator deployment guarantee,\nnot a property of every standalone server. A conforming evaluator must launch\nthe server with `--token-fd`, retain the minted token only in its trusted control\nchannel, perform a post-smoke, pre-scoring reset, and replace the participant\nwhenever the server is replaced. Under that contract, smoke work is excluded\nand participant code cannot reset the epoch because it never receives the\ncontrol token. Tokenless local/development servers intentionally accept\nlifecycle control operations and are not hardened participant boundaries. An\nincompatible peer that lacks authoritative summary support raises an actionable\nerror instead of returning partial or zero-filled data."},"478":{"id":"/docs/getting-started/competition-42","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Both flat and namespaced summaries are constructed in `O(K)` time for the\noperation and optional namespace buckets returned, independent of historical\ncall count. `budget_summary()` and `budget.summary()` format those same mappings.\nOpting into `by_namespace=True` adds the namespace breakdown without changing\nthe flat budget, FLOP, operation, or timing totals."},"479":{"id":"/docs/getting-started/competition-43","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Summary inspection contributes FLOPScope overhead. The current call takes its\nsnapshot first and commits its measured inspection overhead afterward, so that\noverhead appears in the next snapshot or a later final-close snapshot. A final\nclose response cannot recursively include its own post-boundary serialization."},"480":{"id":"/docs/getting-started/competition-44","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"An explicit `BudgetContext` has three summary states:"},"481":{"id":"/docs/getting-started/competition-45","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Before its first entry, `summary_dict()` returns the canonical empty mapping."},"482":{"id":"/docs/getting-started/competition-46","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"While it is active, `summary_dict()` requests that authoritative server\nresource and preserves the client-owned context's existing end-to-end timing\nmeaning by normalizing only the four top-level timing fields."},"483":{"id":"/docs/getting-started/competition-47","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"After close, `summary_dict()` returns a defensive copy of the cached final\nmapping. Later session activity cannot change it."},"484":{"id":"/docs/getting-started/competition-48","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#reading-the-budget-summary","content":"Live scalar timing properties deliberately keep their existing\n`None`/zero-until-close behavior. After close, all scalar timing properties are\nread from that same cached mapping, so scalar, dictionary, and formatted views\ncannot diverge. Client-only timing measurements are not sent to the server and\ncannot change FLOPs, operations, namespaces, budgets, the global session\nsummary, or scoring."},"485":{"id":"/docs/getting-started/competition-49","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#quick-tips-for-competition","content":"**Check costs before committing budget.** Use cost query functions to estimate before executing:"},"486":{"id":"/docs/getting-started/competition-50","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#quick-tips-for-competition","content":"**Use namespaces for phases.** Split your solution into named phases (e.g., `\"init\"`, `\"solve\"`, `\"refine\"`) so the budget summary shows exactly where FLOPs are spent."},"487":{"id":"/docs/getting-started/competition-51","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#quick-tips-for-competition","content":"**Exploit symmetry for savings.** If your tensors are symmetric, wrapping them with `flops.as_symmetric()` can halve pointwise costs and significantly reduce einsum costs. See Symmetry Savings for details."},"488":{"id":"/docs/getting-started/competition-52","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#quick-tips-for-competition","content":"**Prefer cheaper operations.** A matrix-vector product via `fnp.einsum('ij,j->i', A, x)` costs `m*n` FLOPs, while a full matrix-matrix multiply costs `m*n*k`. Avoid computing more than you need."},"489":{"id":"/docs/getting-started/competition-53","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#quick-tips-for-competition","content":"**Watch out for hidden costs.** Operations like `fnp.array()` and `fnp.concatenate()` are *not* free -- they charge `numel(output)` FLOPs, and `fnp.where()` charges `numel(condition)`. Check the cost of any operation you are unsure about."},"490":{"id":"/docs/getting-started/competition-54","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#local-vs-remote-backends","content":"You develop against the in-process `flopscope`, but AIcrowd runs your code on\nthe remote (client/server) backend. Five callback-taking ops —\n`apply_along_axis`, `apply_over_axes`, `fromfunction`, `fromiter`, `piecewise`\n— work in-process but raise `RemoteCallbackError` remotely, because a Python\ncallback can't be sent over the wire. Calling them in-process now emits a\n`RemoteCallbackWarning`; enumerate the set with\n`flopscope.remote_unsupported_ops()`. Precompute these results or avoid the ops\nin submitted code. Passing a generator, lambda, dict, or other non-array\nobject where an array is expected now fails the same way in-process and\nremotely: NumPy coerces it to an `object`-dtype array and flopscope raises\n`UnsupportedDtypeError` before anything is sent over the wire, because an\nobject cell can hold unbounded computation the cost model cannot price. Pass\nmaterialized numeric arrays or built-in scalars instead."},"491":{"id":"/docs/getting-started/competition-55","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#immutable-arrays","content":"flopscope arrays are **immutable**, like JAX arrays. Item assignment and indexed in-place updates raise `TypeError`:"},"492":{"id":"/docs/getting-started/competition-56","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#immutable-arrays","content":"The `+=` is a red herring: `layer_sums[i] += value` desugars to\n`layer_sums[i] = layer_sums[i] + value`, so it is the *indexed assignment* that\nfails, not the addition. Whole-array `+=` (no index on the left) is fine."},"493":{"id":"/docs/getting-started/competition-57","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#immutable-arrays","content":"Build results functionally instead. Collect the pieces and stack them once:"},"494":{"id":"/docs/getting-started/competition-58","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#immutable-arrays","content":"...or keep a running total with a whole-array update:"},"495":{"id":"/docs/getting-started/competition-59","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#immutable-arrays","content":"This is also a local-vs-remote difference: the in-process `flopscope` backend is\na NumPy subclass and currently tolerates `arr[i] = ...`, but the remote backend\nAIcrowd grades on rejects it. Write the functional form so local runs and graded\nruns behave identically."},"496":{"id":"/docs/getting-started/competition-60","page_id":"/docs/getting-started/competition","tags":[],"type":"text","url":"/docs/getting-started/competition#when-things-go-wrong","content":"If you hit `BudgetExhaustedError`, see Budget Planning & Debugging for a systematic approach to diagnosing overruns and reducing costs."},"497":{"id":"/docs/getting-started/installation","page_id":"/docs/getting-started/installation","type":"page","content":"Installation","breadcrumbs":["Documentation","Getting Started"],"tags":[],"url":"/docs/getting-started/installation"},"498":{"id":"/docs/getting-started/installation-0","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#install-the-latest-stable-release-pypi","content":"Install the latest stable release (PyPI)"},"499":{"id":"/docs/getting-started/installation-1","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#install-the-bleeding-edge-version-git","content":"Install the bleeding-edge version (git)"},"500":{"id":"/docs/getting-started/installation-2","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#install-for-development","content":"Install for development"},"501":{"id":"/docs/getting-started/installation-3","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#verify-installation","content":"Verify installation"},"502":{"id":"/docs/getting-started/installation-4","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#what-youll-see","content":"What you'll see"},"503":{"id":"/docs/getting-started/installation-5","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#common-pitfalls","content":"Common pitfalls"},"504":{"id":"/docs/getting-started/installation-6","page_id":"/docs/getting-started/installation","type":"heading","tags":[],"url":"/docs/getting-started/installation#related-pages","content":"Related pages"},"505":{"id":"/docs/getting-started/installation-7","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"*Use this page when setting up flopscope for the first time.*"},"506":{"id":"/docs/getting-started/installation-8","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"**You will learn:**"},"507":{"id":"/docs/getting-started/installation-9","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"How to install the latest stable release from PyPI"},"508":{"id":"/docs/getting-started/installation-10","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"How to install the bleeding-edge version directly from git"},"509":{"id":"/docs/getting-started/installation-11","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"How to set up a development install"},"510":{"id":"/docs/getting-started/installation-12","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"How to verify your installation works"},"511":{"id":"/docs/getting-started/installation-13","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation","content":"How to fix common installation pitfalls"},"512":{"id":"/docs/getting-started/installation-14","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#install-the-latest-stable-release-pypi","content":"Use this for most cases. Releases follow Semantic Versioning;\nsee the CHANGELOG\nfor what's in each release."},"513":{"id":"/docs/getting-started/installation-15","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#install-the-bleeding-edge-version-git","content":"Use this if you need a fix or feature that hasn't shipped to PyPI yet.\nAppend `@<ref>` to pin to a branch, tag, or commit — e.g.\n`...flopscope.git@main` or `...flopscope.git@v0.2.0`."},"514":{"id":"/docs/getting-started/installation-16","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#install-for-development","content":"This gives you an editable install plus the `dev`, `docs`, and `sympy` extras."},"515":{"id":"/docs/getting-started/installation-17","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#what-youll-see","content":"The version string includes the installed NumPy version suffix. If you see a version number, flopscope is installed correctly."},"516":{"id":"/docs/getting-started/installation-18","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#common-pitfalls","content":"**Symptom:** `ImportError: numpy version mismatch`"},"517":{"id":"/docs/getting-started/installation-19","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#common-pitfalls","content":"**Fix:** Flopscope supports NumPy `>=2.0.0,<2.3.0` (default install uses NumPy 2.2). Using `uv` handles this automatically. If you installed manually, check your NumPy version:"},"518":{"id":"/docs/getting-started/installation-20","page_id":"/docs/getting-started/installation","tags":[],"type":"text","url":"/docs/getting-started/installation#related-pages","content":"Quickstart — run your first FLOP-counted computation"},"519":{"id":"/docs/getting-started/quickstart","page_id":"/docs/getting-started/quickstart","type":"page","content":"Quickstart","breadcrumbs":["Documentation","Getting Started"],"tags":[],"url":"/docs/getting-started/quickstart"},"520":{"id":"/docs/getting-started/quickstart-0","page_id":"/docs/getting-started/quickstart","type":"heading","tags":[],"url":"/docs/getting-started/quickstart#prerequisites","content":"Prerequisites"},"521":{"id":"/docs/getting-started/quickstart-1","page_id":"/docs/getting-started/quickstart","type":"heading","tags":[],"url":"/docs/getting-started/quickstart#quickest-possible-start","content":"Quickest possible start"},"522":{"id":"/docs/getting-started/quickstart-2","page_id":"/docs/getting-started/quickstart","type":"heading","tags":[],"url":"/docs/getting-started/quickstart#what-youll-see","content":"What you'll see"},"523":{"id":"/docs/getting-started/quickstart-3","page_id":"/docs/getting-started/quickstart","type":"heading","tags":[],"url":"/docs/getting-started/quickstart#next-steps","content":"Next steps"},"524":{"id":"/docs/getting-started/quickstart-4","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart","content":"*Run your first FLOP-counted computation in under 2 minutes.*"},"525":{"id":"/docs/getting-started/quickstart-5","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart","content":"**You will learn:**"},"526":{"id":"/docs/getting-started/quickstart-6","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart","content":"How to run a FLOP-counted computation with the global default budget"},"527":{"id":"/docs/getting-started/quickstart-7","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart","content":"How to read the budget summary output"},"528":{"id":"/docs/getting-started/quickstart-8","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#prerequisites","content":"Installation"},"529":{"id":"/docs/getting-started/quickstart-9","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#quickest-possible-start","content":"You do not need to set up a budget context to start counting FLOPs. flopscope activates a global default context the first time any counted operation runs. The default budget is 1e15 FLOPs (configurable via the `FLOPSCOPE_DEFAULT_BUDGET` environment variable)."},"530":{"id":"/docs/getting-started/quickstart-10","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#quickest-possible-start","content":"Save this as `first_budget.py`:"},"531":{"id":"/docs/getting-started/quickstart-11","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#quickest-possible-start","content":"Run it:"},"532":{"id":"/docs/getting-started/quickstart-12","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#what-youll-see","content":"**Reading the output:**"},"533":{"id":"/docs/getting-started/quickstart-13","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#what-youll-see","content":"**Top rows:** `Used` is the total FLOP count spent so far across the current session, and `Remaining` shows the implicit global headroom"},"534":{"id":"/docs/getting-started/quickstart-14","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#what-youll-see","content":"**Flat default:** the summary stays flat unless you explicitly ask for `flops.budget_summary(by_namespace=True)`"},"535":{"id":"/docs/getting-started/quickstart-15","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#what-youll-see","content":"**Operations table:** the 10-layer MLP is dominated by `random.randn` for weight init (\\~80%) and the per-layer matrix-vector `einsum` (\\~10%); `multiply` and `array` from the Kaiming-scaled init each contribute \\~5%, activations (`maximum`) are comparatively cheap, and the Kaiming scale `sqrt` adds just 1 FLOP"},"536":{"id":"/docs/getting-started/quickstart-16","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#what-youll-see","content":"If you want namespace attribution, opt in separately:"},"537":{"id":"/docs/getting-started/quickstart-17","page_id":"/docs/getting-started/quickstart","tags":[],"type":"text","url":"/docs/getting-started/quickstart#next-steps","content":"Ready for budget limits? See the Competition Guide."},"538":{"id":"/docs/guides/budget-planning","page_id":"/docs/guides/budget-planning","type":"page","content":"Budget Planning & Debugging","breadcrumbs":["Documentation","Guides"],"tags":[],"url":"/docs/guides/budget-planning"},"539":{"id":"/docs/guides/budget-planning-0","page_id":"/docs/guides/budget-planning","type":"heading","tags":[],"url":"/docs/guides/budget-planning#estimate-before-running","content":"Estimate before running"},"540":{"id":"/docs/guides/budget-planning-1","page_id":"/docs/guides/budget-planning","type":"heading","tags":[],"url":"/docs/guides/budget-planning#budget-breakdown-example","content":"Budget breakdown example"},"541":{"id":"/docs/guides/budget-planning-2","page_id":"/docs/guides/budget-planning","type":"heading","tags":[],"url":"/docs/guides/budget-planning#read-the-budget-summary","content":"Read the budget summary"},"542":{"id":"/docs/guides/budget-planning-3","page_id":"/docs/guides/budget-planning","type":"heading","tags":[],"url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"Add a time limit when FLOPs are not the only risk"},"543":{"id":"/docs/guides/budget-planning-4","page_id":"/docs/guides/budget-planning","type":"heading","tags":[],"url":"/docs/guides/budget-planning#diagnose-overruns","content":"Diagnose overruns"},"544":{"id":"/docs/guides/budget-planning-5","page_id":"/docs/guides/budget-planning","type":"heading","tags":[],"url":"/docs/guides/budget-planning#what-to-do-next","content":"What to do next"},"545":{"id":"/docs/guides/budget-planning-6","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning","content":"*Estimate costs before running and diagnose overruns after.*"},"546":{"id":"/docs/guides/budget-planning-7","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning","content":"**You will learn:**"},"547":{"id":"/docs/guides/budget-planning-8","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning","content":"How to use cost query functions to estimate FLOPs without executing"},"548":{"id":"/docs/guides/budget-planning-9","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning","content":"How to read and interpret the budget summary"},"549":{"id":"/docs/guides/budget-planning-10","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning","content":"How to diagnose expensive operations using the operation log"},"550":{"id":"/docs/guides/budget-planning-11","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning","content":"Optimization strategies for reducing FLOP consumption"},"551":{"id":"/docs/guides/budget-planning-12","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#estimate-before-running","content":"Flopscope provides cost query functions that compute FLOP costs from shapes without executing anything or touching the budget. Use these to plan before committing FLOPs:"},"552":{"id":"/docs/guides/budget-planning-13","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#estimate-before-running","content":"For multi-operand einsums (3+ operands), use `fnp.einsum_path()` to see the step-by-step contraction breakdown with per-step costs and symmetry savings:"},"553":{"id":"/docs/guides/budget-planning-14","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#estimate-before-running","content":"`fnp.einsum_path()` does not execute the contraction, but it does record a nominal 1-FLOP planning event so the path query itself is still visible in the operation log."},"554":{"id":"/docs/guides/budget-planning-15","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#budget-breakdown-example","content":"Plan a multi-step computation before executing:"},"555":{"id":"/docs/guides/budget-planning-16","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#read-the-budget-summary","content":"Call `flops.budget_summary()` after your computation for a human-readable breakdown, or `budget.summary()` inside a context. Pass `by_namespace=True` when you want dotted namespace attribution:"},"556":{"id":"/docs/guides/budget-planning-17","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#read-the-budget-summary","content":"The summary shows cost per operation type, sorted by highest cost first. Look for operations consuming a disproportionate share of the budget. When you opt into `by_namespace=True`, the display adds a namespace breakdown for the exact dotted paths recorded in that run."},"557":{"id":"/docs/guides/budget-planning-18","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#read-the-budget-summary","content":"The structured `summary_dict()` and `budget_summary_dict()` accessors do not\nscan raw call history. At fixed rollup cardinality, cost is independent of raw\nhistorical-call count and scales with distinct operation/namespace buckets\naggregated, plus the defensive copy returned. Live contexts recompute wall and\nresidual timing for each snapshot."},"558":{"id":"/docs/guides/budget-planning-19","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#read-the-budget-summary","content":"When either accessor runs inside an active budget context, its instrumentation\noverhead is billed to the calling thread's active context, not necessarily the\ncontext being inspected, after the snapshot boundary. It therefore appears in\nthat active context's next snapshot or final close. A closed-context read\noutside an active budget context commits no budget overhead."},"559":{"id":"/docs/guides/budget-planning-20","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#read-the-budget-summary","content":"For programmatic analysis, use `flops.budget_summary_dict()`:"},"560":{"id":"/docs/guides/budget-planning-21","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#read-the-budget-summary","content":"Use `flops.budget_summary_dict(by_namespace=True)` for exact per-namespace breakdowns keyed by the full dotted path:"},"561":{"id":"/docs/guides/budget-planning-22","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"Some operations are analytically cheap enough to fit the FLOP budget but still\nslow in practice. Use `wall_time_limit_s` on the same `BudgetContext` when you\nwant a cooperative wall-clock deadline in addition to the FLOP cap:"},"562":{"id":"/docs/guides/budget-planning-23","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"When the time limit is exceeded, Flopscope raises `TimeExhaustedError` at the next\noperation boundary. The summary exposes four timing views that decompose wall time exactly:"},"563":{"id":"/docs/guides/budget-planning-24","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"`wall_time_s`: total elapsed time for the context"},"564":{"id":"/docs/guides/budget-planning-25","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"`flopscope_backend_time_s`: time spent inside the underlying NumPy / BLAS / LAPACK backend calls being counted (including data-movement ops like `tile`, `take`, `pad`, `resize`)"},"565":{"id":"/docs/guides/budget-planning-26","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"`flopscope_overhead_time_s`: time spent in flopscope's own dispatch code (wrapper preambles, FLOP cost computation, view-casts, post-call wrapping, `maybe_check_nan_inf` when opted in via `flopscope.configure(check_nan_inf=True)`)"},"566":{"id":"/docs/guides/budget-planning-27","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"`residual_wall_time_s`: the measured wall-clock remainder outside backend calls and flopscope overhead (user Python between ops, `time.sleep`, GC pauses, un-instrumented numpy, and the callback time of `apply_along_axis` / `apply_over_axes` / `piecewise` / `fromfunction` / `fromiter`)"},"567":{"id":"/docs/guides/budget-planning-28","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"The identity `wall_time_s = flopscope_backend_time_s + flopscope_overhead_time_s + residual_wall_time_s` holds within numerical tolerance."},"568":{"id":"/docs/guides/budget-planning-29","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#add-a-time-limit-when-flops-are-not-the-only-risk","content":"Use `budget.summary()` when you want the current context's timings, and\n`flops.budget_summary()` when you want the accumulated session/global view."},"569":{"id":"/docs/guides/budget-planning-30","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"When you hit a `BudgetExhaustedError`, the budget's operation log gives per-call detail:"},"570":{"id":"/docs/guides/budget-planning-31","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Each `OpRecord` contains:"},"571":{"id":"/docs/guides/budget-planning-32","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Field"},"572":{"id":"/docs/guides/budget-planning-33","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Description"},"573":{"id":"/docs/guides/budget-planning-34","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`op_name`"},"574":{"id":"/docs/guides/budget-planning-35","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Operation name (e.g., `\"einsum\"`, `\"exp\"`)"},"575":{"id":"/docs/guides/budget-planning-36","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`namespace`"},"576":{"id":"/docs/guides/budget-planning-37","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Effective namespace path recorded for that operation"},"577":{"id":"/docs/guides/budget-planning-38","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`subscripts`"},"578":{"id":"/docs/guides/budget-planning-39","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Einsum subscript string, or `None`"},"579":{"id":"/docs/guides/budget-planning-40","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`shapes`"},"580":{"id":"/docs/guides/budget-planning-41","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Tuple of input shapes"},"581":{"id":"/docs/guides/budget-planning-42","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`flop_cost`"},"582":{"id":"/docs/guides/budget-planning-43","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"FLOP cost of this single call"},"583":{"id":"/docs/guides/budget-planning-44","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`cumulative`"},"584":{"id":"/docs/guides/budget-planning-45","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Running total after this call"},"585":{"id":"/docs/guides/budget-planning-46","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`flopscope_context_start_offset_s`"},"586":{"id":"/docs/guides/budget-planning-47","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Seconds from the active `BudgetContext` start to when this operation was recorded"},"587":{"id":"/docs/guides/budget-planning-48","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`flopscope_backend_duration_s`"},"588":{"id":"/docs/guides/budget-planning-49","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Seconds spent in the underlying backend call for this operation"},"589":{"id":"/docs/guides/budget-planning-50","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"`flopscope_overhead_duration_s`"},"590":{"id":"/docs/guides/budget-planning-51","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Seconds of flopscope wrapper/accounting overhead attributed to this operation"},"591":{"id":"/docs/guides/budget-planning-52","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"Look for the operation where `cumulative` jumps sharply -- that is your most expensive call."},"592":{"id":"/docs/guides/budget-planning-53","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#diagnose-overruns","content":"For real-time monitoring during long computations, use the live budget display:"},"593":{"id":"/docs/guides/budget-planning-54","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#what-to-do-next","content":"Once you have identified the expensive operations, apply these strategies:"},"594":{"id":"/docs/guides/budget-planning-55","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#what-to-do-next","content":"**Reduce dimensions.** If `random.randn(1024, 1024)` is too expensive, try smaller arrays. A 512x512 matrix costs 1/4 the FLOPs of a 1024x1024 matrix for a matmul."},"595":{"id":"/docs/guides/budget-planning-56","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#what-to-do-next","content":"**Exploit symmetry.** If operands are symmetric, use `flops.as_symmetric()` to halve pointwise costs and significantly reduce einsum costs. See Symmetry Savings."},"596":{"id":"/docs/guides/budget-planning-57","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#what-to-do-next","content":"**Use cheaper operations.** A matrix-vector product costs `m*n` FLOPs, while a matrix-matrix product costs `m*n*k`. Avoid computing full matrix products when you only need a few rows or a single vector result."},"597":{"id":"/docs/guides/budget-planning-58","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#what-to-do-next","content":"**Increase budget.** If the computation is genuinely needed and you have headroom, raise `flop_budget` on the `BudgetContext`."},"598":{"id":"/docs/guides/budget-planning-59","page_id":"/docs/guides/budget-planning","tags":[],"type":"text","url":"/docs/guides/budget-planning#what-to-do-next","content":"**Split into phases.** Use namespaces to attribute different phases without splitting the FLOP budget into child budgets:"},"599":{"id":"/docs/guides/einsum","page_id":"/docs/guides/einsum","type":"page","content":"Einsum Patterns","breadcrumbs":["Documentation","Guides"],"tags":[],"url":"/docs/guides/einsum"},"600":{"id":"/docs/guides/einsum-0","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#prerequisites","content":"Prerequisites"},"601":{"id":"/docs/guides/einsum-1","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#common-patterns","content":"Common patterns"},"602":{"id":"/docs/guides/einsum-2","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#cost-formula","content":"Cost formula"},"603":{"id":"/docs/guides/einsum-3","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#fnpdot-and-fnpmatmul","content":"fnp.dot and fnp.matmul"},"604":{"id":"/docs/guides/einsum-4","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#symmetric-tensors","content":"Symmetric tensors"},"605":{"id":"/docs/guides/einsum-5","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#inspecting-costs","content":"Inspecting costs"},"606":{"id":"/docs/guides/einsum-6","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#inspecting-what-gets-charged","content":"Inspecting what gets charged"},"607":{"id":"/docs/guides/einsum-7","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#custom-contraction-paths","content":"Custom contraction paths"},"608":{"id":"/docs/guides/einsum-8","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#path-caching","content":"Path caching"},"609":{"id":"/docs/guides/einsum-9","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#cache-management","content":"Cache management"},"610":{"id":"/docs/guides/einsum-10","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#common-pitfalls","content":"Common pitfalls"},"611":{"id":"/docs/guides/einsum-11","page_id":"/docs/guides/einsum","type":"heading","tags":[],"url":"/docs/guides/einsum#related-pages","content":"Related pages"},"612":{"id":"/docs/guides/einsum-12","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum","content":"*Use this page to understand `fnp.einsum` -- the core computation primitive in flopscope.*"},"613":{"id":"/docs/guides/einsum-13","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum","content":"**You will learn:**"},"614":{"id":"/docs/guides/einsum-14","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum","content":"How to write common einsum patterns and understand their FLOP costs"},"615":{"id":"/docs/guides/einsum-15","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum","content":"How to use symmetric tensors with einsum for cost savings"},"616":{"id":"/docs/guides/einsum-16","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum","content":"How to inspect and customize contraction paths"},"617":{"id":"/docs/guides/einsum-17","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum","content":"How to leverage path caching for repeated operations"},"618":{"id":"/docs/guides/einsum-18","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#prerequisites","content":"Quickstart"},"619":{"id":"/docs/guides/einsum-19","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"The cost of an einsum is the sum of per-step costs along the optimal contraction path. Every einsum — even a simple two-operand one — goes through the opt\\_einsum path optimizer (a symmetry-aware fork of opt\\_einsum)."},"620":{"id":"/docs/guides/einsum-20","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"For each pairwise contraction step the cost decomposes into a multiplicative term `μ` and an accumulation term `α`:"},"621":{"id":"/docs/guides/einsum-21","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"where `μ` is the product of all index dimensions (the FMAs you'd issue) and `α` charges the accumulation across the contracted axes. The α/M model counts multiplies and adds separately (FMA=2 textbook); the factor-of-2 you see for dense matmul comes from `μ` counting multiplies and `α` counting accumulation adds."},"622":{"id":"/docs/guides/einsum-22","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"For `'ij,jk->ik'` with shapes `(256, 256)` and `(256, 256)`:"},"623":{"id":"/docs/guides/einsum-23","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"Indices: i=256, j=256, k=256"},"624":{"id":"/docs/guides/einsum-24","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"μ = 256 × 256 × 256 = 16,777,216"},"625":{"id":"/docs/guides/einsum-25","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"α = 16,777,216"},"626":{"id":"/docs/guides/einsum-26","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"Cost: 33,554,432"},"627":{"id":"/docs/guides/einsum-27","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"For multi-operand einsums (3+ tensors), Flopscope automatically decomposes the contraction into optimal pairwise steps. The total cost is the sum of per-step costs."},"628":{"id":"/docs/guides/einsum-28","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#cost-formula","content":"When symmetric tensors are involved, each step's cost is further reduced by the ratio of unique output elements to total output elements. See Symmetry Savings for the full practical guide."},"629":{"id":"/docs/guides/einsum-29","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#fnpdot-and-fnpmatmul","content":"`fnp.dot(A, B)` and `fnp.matmul(A, B)` are equivalent to the corresponding einsum and have the same FLOP cost."},"630":{"id":"/docs/guides/einsum-30","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#symmetric-tensors","content":"There are two separate symmetry declarations — one for inputs, one for outputs:"},"631":{"id":"/docs/guides/einsum-31","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#symmetric-tensors","content":"**Input symmetry** — wrap with `flops.as_symmetric()` before passing to einsum. The optimizer automatically uses symmetry to choose the best contraction order and charges reduced costs:"},"632":{"id":"/docs/guides/einsum-32","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#symmetric-tensors","content":"**Output symmetry** — pass `symmetry=` to `einsum()` to declare that the result is symmetric. This wraps the output as a `SymmetricTensor` so downstream operations benefit from reduced costs. It does NOT affect the cost of this einsum — it's a declaration about the result's structure:"},"633":{"id":"/docs/guides/einsum-33","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#symmetric-tensors","content":"For the full symmetry guide, see Symmetry Savings."},"634":{"id":"/docs/guides/einsum-34","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-costs","content":"`fnp.einsum_path()` previews the contraction plan without executing the contraction itself. Planning is cheap: it records a nominal 1-FLOP `einsum_path` event, but none of the contraction FLOPs are spent."},"635":{"id":"/docs/guides/einsum-35","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-costs","content":"The printed table shows the contraction order, the α/M cost (path-independent — naive and optimized are equal by construction), largest intermediate, grouped index sizes, and one row per pairwise contraction step. Each step shows the chosen contract tuple, subscript, per-step FLOPs, and BLAS tag."},"636":{"id":"/docs/guides/einsum-36","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-costs","content":"For per-step debugging, call `print(info.format_table(verbose=True))`. The verbose view adds indented rows with the merged operand subset, the intermediate output shape, and the running cumulative cost."},"637":{"id":"/docs/guides/einsum-37","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-costs","content":"For the symmetric-vs-dense FLOP breakdown that the path-independent total doesn't expose, use `flops.einsum_accumulation_cost(...).describe()` — see the inspection section below."},"638":{"id":"/docs/guides/einsum-38","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-what-gets-charged","content":"If you want to see the exact FLOP cost flopscope will charge for an einsum (without actually running it), call `flops.einsum_accumulation_cost`:"},"639":{"id":"/docs/guides/einsum-39","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-what-gets-charged","content":"The cost is path-independent: `flops.einsum_accumulation_cost(...).total` matches `info.optimized_cost` from `fnp.einsum_path(...)`, and both equal the FLOPs that `BudgetContext` will charge when you actually call `fnp.einsum(...)`. Repeated calls hit an LRU cache and return in microseconds — see `flops.einsum_cache_info()` and `flops.einsum_clear_caches()` if you need to reset between cold-call benchmarks."},"640":{"id":"/docs/guides/einsum-40","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#inspecting-what-gets-charged","content":"For inputs with declared symmetry, the returned total reflects the orbit-aware savings — see Symmetry-aware FLOP counting for the mental model."},"641":{"id":"/docs/guides/einsum-41","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#custom-contraction-paths","content":"By default Flopscope finds the optimal contraction order automatically. You can override this by passing an explicit path — a list of int-tuples specifying which operand positions to contract at each step:"},"642":{"id":"/docs/guides/einsum-42","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#custom-contraction-paths","content":"You can also specify a completely custom path. Each tuple names the positions (in the current operand list) to contract; the result is appended to the end:"},"643":{"id":"/docs/guides/einsum-43","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#custom-contraction-paths","content":"Different paths may have different FLOP costs. Use `fnp.einsum_path()` to compare — it returns the plan without executing the contraction."},"644":{"id":"/docs/guides/einsum-44","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#path-caching","content":"Contraction paths are cached automatically in a module-level LRU cache.\nWhen you call `fnp.einsum()` with the same subscripts, shapes, optimizer,\nand symmetry structure, the path is reused from cache instead of being\nrecomputed. This makes repeated einsums in loops essentially free in\npath-finding overhead:"},"645":{"id":"/docs/guides/einsum-45","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#path-caching","content":"`fnp.einsum_path()` shares the same cache, so planning a path warms the\ncache for subsequent `fnp.einsum()` calls and vice versa."},"646":{"id":"/docs/guides/einsum-46","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#common-pitfalls","content":"**Symptom:** Unexpectedly high FLOP cost"},"647":{"id":"/docs/guides/einsum-47","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#common-pitfalls","content":"**Fix:** Check all index dimensions. A subscript like `'ijkl,jklm->im'` multiplies all five dimension sizes together. Use `flops.accounting.einsum_cost()` or `fnp.einsum_path()` to preview costs before executing."},"648":{"id":"/docs/guides/einsum-48","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#related-pages","content":"Symmetry Savings — full guide to symmetry mechanisms"},"649":{"id":"/docs/guides/einsum-49","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#related-pages","content":"API Reference — algorithms, symmetry support, and operation details"},"650":{"id":"/docs/guides/einsum-50","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#related-pages","content":"Plan Your Budget — query costs before executing"},"651":{"id":"/docs/guides/einsum-51","page_id":"/docs/guides/einsum","tags":[],"type":"text","url":"/docs/guides/einsum#related-pages","content":"FLOP Counting Model — how costs are computed"},"652":{"id":"/docs/guides/fft","page_id":"/docs/guides/fft","type":"page","content":"FFT Operations","breadcrumbs":["Documentation","Guides"],"tags":[],"url":"/docs/guides/fft"},"653":{"id":"/docs/guides/fft-0","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#prerequisites","content":"Prerequisites"},"654":{"id":"/docs/guides/fft-1","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#cost-model","content":"Cost model"},"655":{"id":"/docs/guides/fft-2","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#basic-usage","content":"Basic usage"},"656":{"id":"/docs/guides/fft-3","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#real-vs-complex-transforms","content":"Real vs complex transforms"},"657":{"id":"/docs/guides/fft-4","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#multi-dimensional-fft","content":"Multi-dimensional FFT"},"658":{"id":"/docs/guides/fft-5","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#windowed-fft-pattern","content":"Windowed FFT pattern"},"659":{"id":"/docs/guides/fft-6","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#query-costs-before-running","content":"Query costs before running"},"660":{"id":"/docs/guides/fft-7","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#common-pitfalls","content":"Common pitfalls"},"661":{"id":"/docs/guides/fft-8","page_id":"/docs/guides/fft","type":"heading","tags":[],"url":"/docs/guides/fft#related-pages","content":"Related pages"},"662":{"id":"/docs/guides/fft-9","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft","content":"*Use this page to learn how to use `fnp.fft` operations and understand their FLOP costs.*"},"663":{"id":"/docs/guides/fft-10","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft","content":"**You will learn:**"},"664":{"id":"/docs/guides/fft-11","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft","content":"How to use 1-D, 2-D, and N-D FFT operations and their cost formulas"},"665":{"id":"/docs/guides/fft-12","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft","content":"How to choose between real and complex transforms to save FLOPs"},"666":{"id":"/docs/guides/fft-13","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft","content":"How to query FFT costs before committing budget"},"667":{"id":"/docs/guides/fft-14","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#prerequisites","content":"Quickstart"},"668":{"id":"/docs/guides/fft-15","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"FFT costs are based on the Cooley-Tukey radix-2 algorithm:"},"669":{"id":"/docs/guides/fft-16","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"Transform"},"670":{"id":"/docs/guides/fft-17","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"Cost Formula"},"671":{"id":"/docs/guides/fft-18","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"Example (n=1024)"},"672":{"id":"/docs/guides/fft-19","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"`fft`, `ifft`"},"673":{"id":"/docs/guides/fft-20","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"$5n \\cdot \\lceil\\log_2 n\\rceil$"},"674":{"id":"/docs/guides/fft-21","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"51,200"},"675":{"id":"/docs/guides/fft-22","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"`rfft`, `irfft`"},"676":{"id":"/docs/guides/fft-23","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"$5(n/2) \\cdot \\lceil\\log_2 n\\rceil$"},"677":{"id":"/docs/guides/fft-24","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"25,600"},"678":{"id":"/docs/guides/fft-25","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"`fft2`, `ifft2`"},"679":{"id":"/docs/guides/fft-26","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"$5N \\cdot \\lceil\\log_2 N\\rceil$ where $N = n_\\{1\\} \\cdot n_\\{2\\}$"},"680":{"id":"/docs/guides/fft-27","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"varies"},"681":{"id":"/docs/guides/fft-28","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"`fftn`, `ifftn`"},"682":{"id":"/docs/guides/fft-29","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"$5N \\cdot \\lceil\\log_2 N\\rceil$ where $N = \\prod_\\{i\\} n_\\{i\\}$"},"683":{"id":"/docs/guides/fft-30","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"varies"},"684":{"id":"/docs/guides/fft-31","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"`fftfreq`, `rfftfreq`"},"685":{"id":"/docs/guides/fft-32","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"0 (free)"},"686":{"id":"/docs/guides/fft-33","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"0"},"687":{"id":"/docs/guides/fft-34","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"`fftshift`, `ifftshift`"},"688":{"id":"/docs/guides/fft-35","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"0 (free)"},"689":{"id":"/docs/guides/fft-36","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"0"},"690":{"id":"/docs/guides/fft-37","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#cost-model","content":"Real-valued transforms (`rfft`, `irfft`, `rfftn`, `irfftn`) cost roughly half of their complex counterparts because they exploit conjugate symmetry."},"691":{"id":"/docs/guides/fft-38","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#real-vs-complex-transforms","content":"When your input is real-valued (which is common in signal processing), prefer `rfft` over `fft` — it costs half as much:"},"692":{"id":"/docs/guides/fft-39","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#real-vs-complex-transforms","content":"The output of `rfft` has shape `(n//2 + 1,)` instead of `(n,)`, since the negative frequencies are redundant for real inputs."},"693":{"id":"/docs/guides/fft-40","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#multi-dimensional-fft","content":"Use `fft2` for 2-D transforms (e.g., images) and `fftn` for arbitrary dimensions:"},"694":{"id":"/docs/guides/fft-41","page_id":"/docs/guides/fft","tags":[],"type":"text","url":"/docs/guides/fft#windowed-fft-pattern","content":"A common signal processing pattern — window the signal before FFT to redu