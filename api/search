cs/development/release-13","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"How `cz bump` updates versions across the three packages and tags"},"235":{"id":"/docs/development/release-14","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"What happens after `git push --follow-tags`"},"236":{"id":"/docs/development/release-15","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release","content":"The one-time PyPI Trusted Publisher setup per project"},"237":{"id":"/docs/development/release-16","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Versions follow Semantic Versioning. While at `0.x`, the project is\nAPI-unstable — breaking changes bump the **minor** digit, not the major.\nCommit types map to bumps as follows:"},"238":{"id":"/docs/development/release-17","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Commit type"},"239":{"id":"/docs/development/release-18","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`0.x` bump"},"240":{"id":"/docs/development/release-19","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`≥1.0` bump"},"241":{"id":"/docs/development/release-20","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`fix:`"},"242":{"id":"/docs/development/release-21","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"patch (`0.2.0` → `0.2.1`)"},"243":{"id":"/docs/development/release-22","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"patch"},"244":{"id":"/docs/development/release-23","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`feat:`"},"245":{"id":"/docs/development/release-24","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"minor (`0.2.0` → `0.3.0`)"},"246":{"id":"/docs/development/release-25","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"minor"},"247":{"id":"/docs/development/release-26","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"`feat!:` / `BREAKING CHANGE:`"},"248":{"id":"/docs/development/release-27","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"minor (`0.2.0` → `0.3.0`)"},"249":{"id":"/docs/development/release-28","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"**major** (`1.4` → `2.0`)"},"250":{"id":"/docs/development/release-29","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Other types (`chore`, `docs`, …)"},"251":{"id":"/docs/development/release-30","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"no release"},"252":{"id":"/docs/development/release-31","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"no release"},"253":{"id":"/docs/development/release-32","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#version-bumps","content":"Commitizen handles this automatically via `major_version_zero = true` in\nthe `[tool.commitizen]` block of `pyproject.toml`. Flip that to `false`\nwhen we cut `v1.0.0`."},"254":{"id":"/docs/development/release-33","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#end-to-end-flow","content":"We release with commitizen.\nEnd-to-end flow:"},"255":{"id":"/docs/development/release-34","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#end-to-end-flow","content":"Why not plain `uv run cz bump`? It commits and tags in one shot, *before*\nthe lockfiles can be refreshed — so the bump commit ships stale `uv.lock`\nfiles and `check-lock` fails on main. If you ran it anyway: `make relock`,\nthen stage the three lockfiles (`git add uv.lock flopscope-server/uv.lock\nflopscope-client/uv.lock`) — an unstaged `--amend` would silently exclude\nthem — then `git commit --amend --no-edit`, and re-point the tag with\n`git tag -fa v<new> -m \"v<new>\"` before pushing."},"256":{"id":"/docs/development/release-35","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#end-to-end-flow","content":"Pre-releases follow the same files-only flow with `--prerelease alpha`\nadded in step 3 (`uv run cz bump --files-only --changelog --prerelease\nalpha`); the relock, verify, commit, and tag steps are identical, with\nthe prerelease version to tag (e.g. `v0.3.0a0`) shown in the bump\noutput."},"257":{"id":"/docs/development/release-36","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"`flopscope`, `flopscope-server`, and `flopscope-client` are released in\nlockstep at the same version. `cz bump` updates **all** version\nlocations in one invocation via the `version_files` config in\n`[tool.commitizen]`:"},"258":{"id":"/docs/development/release-37","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"All three `pyproject.toml` `[project].version` fields"},"259":{"id":"/docs/development/release-38","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"All three `__version__` strings in package `__init__.py` files"},"260":{"id":"/docs/development/release-39","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"Both cross-package pins (`flopscope-server==X.Y.Z` in flopscope's\n`server` extra, and `flopscope==X.Y.Z` in flopscope-server's\n`dependencies`)"},"261":{"id":"/docs/development/release-40","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"Before tagging, `check-sync-versions` asserts that all eight version\nlocations agree. Run locally:"},"262":{"id":"/docs/development/release-41","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#multi-package-lockstep","content":"CI runs this in the `client-server-sync` job on every PR, so drift\nintroduced by hand-edits is caught before merge."},"263":{"id":"/docs/development/release-42","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"The tag push triggers\n`.github/workflows/pypi-publish.yml`,\nwhich:"},"264":{"id":"/docs/development/release-43","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Builds wheels in parallel via a matrix job — one per published\npackage."},"265":{"id":"/docs/development/release-44","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Pauses for approval in the `pypi` GitHub environment (manual gate).\nA single approval click covers all matrix-publish jobs."},"266":{"id":"/docs/development/release-45","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Publishes the packages to PyPI in parallel via Trusted Publishing\n(OIDC; no API token stored in repo secrets)."},"267":{"id":"/docs/development/release-46","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"Creates one GitHub Release whose body is the matching CHANGELOG\nsection for that tag."},"268":{"id":"/docs/development/release-47","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#what-happens-after-git-push---follow-tags","content":"End result: `pip install <package>==X.Y.Z` works \\~2 minutes after a\nmaintainer clicks \"approve\" on the `pypi` environment gate."},"269":{"id":"/docs/development/release-48","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Before the first release will succeed, configure two things outside the\nrepo. The Trusted Publisher steps must be repeated for **each** PyPI\nproject name being published."},"270":{"id":"/docs/development/release-49","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"**On PyPI — add a Trusted Publisher (do this for each project name):**"},"271":{"id":"/docs/development/release-50","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Go to https\\://pypi.org/manage/account/publishing/"},"272":{"id":"/docs/development/release-51","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Click \"Add a new pending publisher\""},"273":{"id":"/docs/development/release-52","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Fill in (repeat with each project name in turn):"},"274":{"id":"/docs/development/release-53","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"PyPI Project Name: `flopscope`, then `flopscope-server`, then\n`flopscope-client`"},"275":{"id":"/docs/development/release-54","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Owner: `AIcrowd`"},"276":{"id":"/docs/development/release-55","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Repository name: `flopscope`"},"277":{"id":"/docs/development/release-56","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Workflow name: `pypi-publish.yml`"},"278":{"id":"/docs/development/release-57","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Environment name: `pypi`"},"279":{"id":"/docs/development/release-58","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Save each one."},"280":{"id":"/docs/development/release-59","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"**On GitHub — create the `pypi` environment with required reviewers\n(do this once; it is shared across all matrix-publish jobs):**"},"281":{"id":"/docs/development/release-60","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Go to https\\://github.com/AIcrowd/flopscope/settings/environments"},"282":{"id":"/docs/development/release-61","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Click \"New environment\", name it `pypi`"},"283":{"id":"/docs/development/release-62","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Under \"Deployment protection rules\" → \"Required reviewers\", add the\nrelease maintainers"},"284":{"id":"/docs/development/release-63","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"Save"},"285":{"id":"/docs/development/release-64","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#first-time-pypi-setup-one-time-per-project","content":"After all configured Trusted Publishers and the shared environment are\nset up, the next `v*` tag push will trigger the publish flow\nend-to-end — and a single approval click covers all matrix publishes."},"286":{"id":"/docs/development/release-65","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#manual-publish-from-a-maintainers-machine-fallback","content":"The normal path is the matrix workflow described above. Use this section only\nwhen GitHub Actions is unavailable or won't fire (Actions outage, repo policy\nglitch, etc.) and you need to ship a release right now. This path bypasses\nTrusted Publishing, the `pypi` environment approval gate, and the auto-created\nGitHub Release."},"287":{"id":"/docs/development/release-66","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Install `twine` as a uv-managed tool\n(keeps it out of project dependencies):"},"288":{"id":"/docs/development/release-67","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Generate three **project-scoped** PyPI API tokens, one per project. For\neach of `flopscope`, `flopscope-server`, `flopscope-client`:"},"289":{"id":"/docs/development/release-68","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Go to https\\://pypi.org/manage/account/token/"},"290":{"id":"/docs/development/release-69","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Click \"Add API token\""},"291":{"id":"/docs/development/release-70","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"**Token name:** something self-descriptive (e.g. `flopscope-manual-2026`)"},"292":{"id":"/docs/development/release-71","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"**Scope:** \"Project: flopscope\" (scope to a single project — not \"Entire account\")"},"293":{"id":"/docs/development/release-72","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Copy the `pypi-...` token immediately; PyPI will not show it again"},"294":{"id":"/docs/development/release-73","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#one-time-setup","content":"Add all three tokens to `~/.pypirc` (chmod 600 the file). Per-project\nsections let twine pick the right one based on the wheel's distribution\nname:"},"295":{"id":"/docs/development/release-74","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Assumes the bump commit + `vX.Y.Z` tag already exist on `main` (produce\nthem with the End-to-end flow above as usual; the\ndifference is only that the GH workflow won't run)."},"296":{"id":"/docs/development/release-75","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Build all three packages from the tagged commit:"},"297":{"id":"/docs/development/release-76","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Verify each wheel's metadata is what you expect — particularly the\n`Requires-Dist` cross-pin in flopscope-server and the `Provides-Extra: server`\nin flopscope:"},"298":{"id":"/docs/development/release-77","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Upload each wheel + sdist with `twine`, pointing at the per-project section\nof `~/.pypirc`:"},"299":{"id":"/docs/development/release-78","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Twine prints a https\\://pypi.org/project/.../ URL after each successful\nupload. If a previous attempt already uploaded any of the files, add\n`--skip-existing` to make the command idempotent."},"300":{"id":"/docs/development/release-79","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#publishing-vxyz-manually","content":"Create the GitHub Release manually (the workflow would normally do this):"},"301":{"id":"/docs/development/release-80","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"The manual path skips four safety nets the workflow gives you:"},"302":{"id":"/docs/development/release-81","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Environment approval gate.** Anyone with the API tokens can publish; there\nis no second-pair-of-eyes click. Scope tokens narrowly and rotate them after\nuse if leaked or no longer needed."},"303":{"id":"/docs/development/release-82","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Trusted Publishing audit trail.** PyPI records \"uploaded by API token X\"\ninstead of \"uploaded by GH workflow run #...\" — harder to trace."},"304":{"id":"/docs/development/release-83","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Auto-generated GitHub Release with notes from CHANGELOG.** Step 4 above\nis the manual replacement."},"305":{"id":"/docs/development/release-84","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"**Matrix isolation.** Network/IO failures during upload could leave a\npartial publish (e.g., flopscope uploaded but flopscope-server failed).\nIn that case re-run only the failed `twine upload` with `--skip-existing`."},"306":{"id":"/docs/development/release-85","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#trade-offs-vs-the-workflow","content":"Once Actions is healthy again, **switch back to the workflow path** — delete\nthe API tokens you created for the manual publish, and the next `vX.Y.Z` tag\npush will go through Trusted Publishing as normal."},"307":{"id":"/docs/development/release-86","page_id":"/docs/development/release","tags":[],"type":"text","url":"/docs/development/release#related-references","content":"`[tool.commitizen]` in pyproject.toml — release tooling config"},"308":{"id":"/docs/development/release-87","page_id":"/docs/development/release","tags":[],"type":"tex