ting-90","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#allowed-types","content":"Reverting a prior commit"},"217":{"id":"/docs/development/contributing-91","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#allowed-types","content":"(Source of truth: `.gitlint`.)"},"218":{"id":"/docs/development/contributing-92","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#rules","content":"Title MUST start with one of the types above"},"219":{"id":"/docs/development/contributing-93","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#rules","content":"Scope is optional, in parens: `fix(reduction-cost): handle 0-d arrays`"},"220":{"id":"/docs/development/contributing-94","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#rules","content":"Breaking changes: append `!` after the type/scope, OR put `BREAKING CHANGE:`\nin the footer"},"221":{"id":"/docs/development/contributing-95","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#rules","content":"Title MUST be ≤ 90 chars"},"222":{"id":"/docs/development/contributing-96","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#rules","content":"Imperative mood (\"add X\" not \"added X\")"},"223":{"id":"/docs/development/contributing-97","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#rules","content":"No trailing period"},"224":{"id":"/docs/development/contributing-98","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#examples","content":"GOOD:"},"225":{"id":"/docs/development/contributing-99","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#examples","content":"BAD:"},"226":{"id":"/docs/development/contributing-100","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#local-commit-hooks","content":"The repo ships a `commit-msg` hook at `.githooks/commit-msg` that runs\n`gitlint` on every `git commit`. `make install` (above) configures this\nhook via `git config core.hooksPath .githooks`. After that, any commit\nwith a bad message is rejected at commit time, instead of failing later\nin CI."},"227":{"id":"/docs/development/contributing-101","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#validating-messages-programmatically","content":"When automation needs to validate a candidate message before invoking\n`git commit`:"},"228":{"id":"/docs/development/contributing-102","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#validating-messages-programmatically","content":"If `gitlint` exits non-zero, the message will also fail the `commit-msg`\nhook and the CI `lint-commits` job. Fix the message before committing\nrather than retrying via `git commit --amend`."},"229":{"id":"/docs/development/contributing-103","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#which-environment-to-use","content":"The root environment covers the core package, linting, docs, and the main test\nsuite. The client and server each also have their own `pyproject.toml`."},"230":{"id":"/docs/development/contributing-104","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#which-environment-to-use","content":"One important caveat: `flopscope-server` depends on the local `flopscope`\npackage, which is not resolved from a package index in a fresh source checkout.\nFor server development, run commands from the repository root with\n`PYTHONPATH=src:flopscope-server/src` instead of relying on `cd flopscope-server\n&& uv run ...`."},"231":{"id":"/docs/development/contributing-105","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#core-library","content":"If you prefer direct `uv` commands:"},"232":{"id":"/docs/development/contributing-106","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#core-library","content":"When running the local docs site and you want flopscope error messages to link to\nyour local copy instead of the hosted site, set:"},"233":{"id":"/docs/development/contributing-107","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#core-library","content":"If `FLOPSCOPE_DOCS_ROOT` is unset, flopscope falls back to the hosted docs at\n`https://aicrowd.github.io/flopscope/docs`."},"234":{"id":"/docs/development/contributing-108","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#client-package","content":"The client package is independently installable, so its test suite can run via\nits own project file:"},"235":{"id":"/docs/development/contributing-109","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#client-package","content":"Client integration and adversarial tests start a real server subprocess using\nthe repository root `.venv/bin/python`, so run `make install` first."},"236":{"id":"/docs/development/contributing-110","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#server-package","content":"Run server tests from the repository root so the local core package is on\n`PYTHONPATH`:"},"237":{"id":"/docs/development/contributing-111","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#server-package","content":"To launch the server manually from a source checkout:"},"238":{"id":"/docs/development/contributing-112","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#running-client-and-server-together-without-docker","content":"From a source checkout, use repo-root commands so both packages resolve\ncorrectly:"},"239":{"id":"/docs/development/contributing-113","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#running-client-and-server-together-without-docker","content":"See Running with Docker if you want the same split\nusing containers."},"240":{"id":"/docs/development/contributing-114","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#generated-documentation","content":"Generated API and cost-model pages are **not committed** — they are regenerated by\n`scripts/generate_api_docs.py` (run automatically by `make docs-build`, CI, and\n`make docs-serve`). Only `website/public/ops.json` is committed, guarded by\n`generate_api_docs.py --check`. Never hand-edit generated pages; edit the generator,\nthe registry, or the docstrings / `docs/reference/cost-model.md` source."},"241":{"id":"/docs/development/contributing-115","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#generated-documentation","content":"Do not hand-edit `website/public/api-data/ops/*.json`,\n`website/.generated/public-api-routes.json`,\n`website/.generated/op-doc-imports.ts`, `website/.generated/symbol-doc-imports.ts`,\nor `website/.generated/public-api-symbols.json`. The interactive API reference,\ncanonical API pages, and legacy redirect routes consume those generated\nartifacts directly."},"242":{"id":"/docs/development/contributing-116","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#generated-documentation","content":"Instead, update `scripts/generate_api_docs.py`, the relevant source docstrings,\nor the operation registry, then regenerate and verify:"},"243":{"id":"/docs/development/contributing-117","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#numpy-compatibility-testing","content":"flopscope's goal is NumPy API compatibility on the counted surface: `import flopscope.numpy as np` should work for supported functions. To verify this, we run NumPy's own test suite against flopscope."},"244":{"id":"/docs/development/contributing-118","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#how-it-works","content":"A pytest conftest at `tests/numpy_compat/conftest.py` monkeypatches numpy functions with their flopscope equivalents at session start. When we point pytest at NumPy's installed test files using `--pyargs`, every test that calls `np.sum(...)`, `np.mean(...)`, etc. actually calls flopscope's version."},"245":{"id":"/docs/development/contributing-119","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#avoiding-infinite-recursion","content":"flopscope functions internally call numpy (for example, `fnp.dot` eventually delegates to `_np.dot` inside the implementation modules). Since `_np` is the numpy module, patching `numpy.dot = fnp.dot` without isolating those backend references would cause infinite recursion: `fnp.dot` → `_np.dot` → `numpy.dot` → `fnp.dot` → ..."},"246":{"id":"/docs/development/contributing-120","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#avoiding-infinite-recursion","content":"We solve this by **freezing numpy before patching**: the conftest creates a snapshot of the numpy module (and its submodules like `numpy.linalg`, `numpy.fft`), then rebinds every flopscope module's `_np` reference to the frozen copy. Now flopscope's internal calls go to the original numpy functions, while the test suite sees flopscope's versions."},"247":{"id":"/docs/development/contributing-121","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Of flopscope's 508 registered functions, most non-ufunc functions are patched onto numpy during testing. The only categories skipped:"},"248":{"id":"/docs/development/contributing-122","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Category"},"249":{"id":"/docs/development/contributing-123","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Count"},"250":{"id":"/docs/development/contributing-124","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Why skipped"},"251":{"id":"/docs/development/contributing-125","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Ufuncs"},"252":{"id":"/docs/development/contributing-126","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"101"},"253":{"id":"/docs/development/contributing-127","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"flopscope functions are plain callables, not ufuncs -- they lack `.reduce`, `.accumulate`, `.outer`, `.nargs`. Tests check these attributes at collection time."},"254":{"id":"/docs/development/contributing-128","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Blacklisted"},"255":{"id":"/docs/development/contributing-129","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"32"},"256":{"id":"/docs/development/contributing-130","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Intentionally unsupported"},"257":{"id":"/docs/development/contributing-131","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"`linalg.outer`"},"258":{"id":"/docs/development/contributing-132","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"1"},"259":{"id":"/docs/development/contributing-133","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"`fnp.linalg.outer` delegates to `np.outer` (not `np.linalg.outer`), which has different validation behavior"},"260":{"id":"/docs/development/contributing-134","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#what-gets-patched","content":"Everything else -- free ops, counted custom ops (dot, einsum, etc.), submodule functions (linalg, fft), reductions, and special functions -- is patched."},"261":{"id":"/docs/development/contributing-135","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"We run 8 NumPy test modules covering core math, ufuncs, numerics, linear algebra, FFT, polynomials, and random. Counts below are measured with `make test-numpy-compat` on numpy 2.2.6; they shift across the 2.0-2.4 CI matrix."},"262":{"id":"/docs/development/contributing-136","page_id":"/docs/development/contributing","tags":[],"type":"text","url":"/docs/development/contributing#test-suites","content":"Suite"},"263":{"id":"/docs/development/contributing-137","page_id":"/docs/developmen