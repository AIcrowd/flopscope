 copy"},"866":{"id":"/docs/guides/random-8","page_id":"/docs/guides/random","type":"heading","tags":[],"url":"/docs/guides/random#spawn-for-parallel-work","content":"`spawn()` for parallel work"},"867":{"id":"/docs/guides/random-9","page_id":"/docs/guides/random","type":"heading","tags":[],"url":"/docs/guides/random#constructing-from-a-specific-bitgenerator","content":"Constructing from a specific BitGenerator"},"868":{"id":"/docs/guides/random-10","page_id":"/docs/guides/random","type":"heading","tags":[],"url":"/docs/guides/random#pitfall-global-state","content":"Pitfall: global state"},"869":{"id":"/docs/guides/random-11","page_id":"/docs/guides/random","type":"heading","tags":[],"url":"/docs/guides/random#forward-compatibility-integration-with-other-apis","content":"Forward compatibility: integration with other APIs"},"870":{"id":"/docs/guides/random-12","page_id":"/docs/guides/random","type":"heading","tags":[],"url":"/docs/guides/random#whats-deliberately-not-supported","content":"What's deliberately not supported"},"871":{"id":"/docs/guides/random-13","page_id":"/docs/guides/random","type":"heading","tags":[],"url":"/docs/guides/random#related","content":"Related"},"872":{"id":"/docs/guides/random-14","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"*Counted RNGs for reproducible, FLOP-tracked sampling.*"},"873":{"id":"/docs/guides/random-15","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"**You will learn:**"},"874":{"id":"/docs/guides/random-16","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"The three ways to draw random samples in flopscope and when to use each"},"875":{"id":"/docs/guides/random-17","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"How `default_rng()` is the canonical, recommended pattern"},"876":{"id":"/docs/guides/random-18","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"How counted RNGs behave under pickle/copy/spawn"},"877":{"id":"/docs/guides/random-19","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"How they integrate with downstream APIs (e.g. future `flopscope.stats.rvs()`)"},"878":{"id":"/docs/guides/random-20","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random","content":"The one foot-gun left over from numpy's legacy API"},"879":{"id":"/docs/guides/random-21","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#tldr","content":"This is the **canonical pattern**: per-call seed, per-instance state, fully isolated, FLOP-counted."},"880":{"id":"/docs/guides/random-22","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"API"},"881":{"id":"/docs/guides/random-23","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"Status"},"882":{"id":"/docs/guides/random-24","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"Per-instance state?"},"883":{"id":"/docs/guides/random-25","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"Use when"},"884":{"id":"/docs/guides/random-26","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"`fnp.random.default_rng(seed)`"},"885":{"id":"/docs/guides/random-27","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"**canonical** ✅"},"886":{"id":"/docs/guides/random-28","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"yes"},"887":{"id":"/docs/guides/random-29","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"always (modern code)"},"888":{"id":"/docs/guides/random-30","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"`fnp.random.RandomState(seed)`"},"889":{"id":"/docs/guides/random-31","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"first-class"},"890":{"id":"/docs/guides/random-32","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"yes"},"891":{"id":"/docs/guides/random-33","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"porting code from numpy's legacy API"},"892":{"id":"/docs/guides/random-34","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"`fnp.random.randn(...)`, `normal(...)`, etc."},"893":{"id":"/docs/guides/random-35","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"first-class"},"894":{"id":"/docs/guides/random-36","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"shares numpy's global RNG"},"895":{"id":"/docs/guides/random-37","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"short scripts, REPL exploration"},"896":{"id":"/docs/guides/random-38","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#three-ways-to-sample","content":"All three charge FLOPs to the active `BudgetContext`. The difference is *where the random state lives*."},"897":{"id":"/docs/guides/random-39","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#default_rng--canonical-pattern","content":"The returned object is a `numpy.random.Generator` subclass — `isinstance(rng, np.random.Generator)` holds, so it works anywhere a numpy `Generator` is expected."},"898":{"id":"/docs/guides/random-40","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#randomstate--legacy-compat","content":"The legacy `numpy.random.RandomState` API is still supported with full FLOP counting:"},"899":{"id":"/docs/guides/random-41","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#randomstate--legacy-compat","content":"Use this only when you're porting code that already uses `RandomState`. New code should prefer `default_rng()`."},"900":{"id":"/docs/guides/random-42","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#module-level-samplers","content":"`fnp.random.randn`, `normal`, `uniform`, `choice`, `shuffle`, etc. are kept first-class for short scripts and REPL use:"},"901":{"id":"/docs/guides/random-43","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#module-level-samplers","content":"These match `numpy.random` semantics exactly, plus FLOP accounting. **They share numpy's global RNG state**, which is fine for one-shot scripts but creates a foot-gun in longer-running programs — see Pitfall: global state below."},"902":{"id":"/docs/guides/random-44","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#cross-api-parity","content":"Same physical operation charges identical FLOPs regardless of which API you used:"},"903":{"id":"/docs/guides/random-45","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#cross-api-parity","content":"`default_rng().normal(...)` inherits the calibrated weight of the module-level `random.normal` it shadows. No per-method calibration is needed for new method-level entries — runtime aliasing handles it."},"904":{"id":"/docs/guides/random-46","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#pickle-and-copy","content":"Counted RNGs round-trip cleanly through `pickle` and `copy`:"},"905":{"id":"/docs/guides/random-47","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#spawn-for-parallel-work","content":"`Generator.spawn(n)` returns `n` independent counted children that share no state with the parent:"},"906":{"id":"/docs/guides/random-48","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#spawn-for-parallel-work","content":"Each child has its own `bit_generator`, so children running in parallel produce independent streams — no contention, no shared state."},"907":{"id":"/docs/guides/random-49","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#constructing-from-a-specific-bitgenerator","content":"The `Generator(BitGenerator(seed))` idiom from numpy works identically:"},"908":{"id":"/docs/guides/random-50","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#constructing-from-a-specific-bitgenerator","content":"The bit-generator classes (`BitGenerator`, `MT19937`, `PCG64`, `PCG64DXSM`, `Philox`, `SFC64`) pass through to numpy unchanged — they don't do math, so there's nothing to count at the bit-generator level. FLOPs are charged at the sampler-method level on the resulting `Generator`."},"909":{"id":"/docs/guides/random-51","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#pitfall-global-state","content":"The one path that *doesn't* give per-instance isolation is the module-level samplers, because they share numpy's global RNG. Across two sequential `BudgetContext`s:"},"910":{"id":"/docs/guides/random-52","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#pitfall-global-state","content":"If you need each context to be independently reproducible, either re-seed at the top of each context, or use `default_rng()`:"},"911":{"id":"/docs/guides/random-53","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#pitfall-global-state","content":"Note that **`BudgetContext`s cannot be nested** at all (the runtime raises `RuntimeError(\"Cannot nest BudgetContexts\")`), so the global-state issue only affects *sequential* contexts, never overlapping ones."},"912":{"id":"/docs/guides/random-54","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#forward-compatibility-integration-with-other-apis","content":"Anything that accepts a numpy `Generator` accepts a counted `Generator`. For example, when `flopscope.stats` grows an `rvs()` method (random variate sampling), it will accept a counted RNG and inherit FLOP counting for free:"},"913":{"id":"/docs/guides/random-55","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#forward-compatibility-integration-with-other-apis","content":"The pattern works because `rng.uniform(...)` and `fnp.stats.norm.ppf(...)` are both already FLOP-counted. Inverse-CDF sampling threads naturally through the existing wrappers."},"914":{"id":"/docs/guides/random-56","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Pattern"},"915":{"id":"/docs/guides/random-57","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Status"},"916":{"id":"/docs/guides/random-58","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Why"},"917":{"id":"/docs/guides/random-59","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Nested `BudgetContext`s"},"918":{"id":"/docs/guides/random-60","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"runtime error"},"919":{"id":"/docs/guides/random-61","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Out of scope; flopscope models a single budget per program region."},"920":{"id":"/docs/guides/random-62","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Methods not in the registry"},"921":{"id":"/docs/guides/random-63","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"`UnsupportedFunctionError`"},"922":{"id":"/docs/guides/random-64","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Closes the silent-bypass hole from issue #18. New numpy methods are added to the registry on each version bump (CI: `scripts/numpy_audit.py --ci`)."},"923":{"id":"/docs/guides/random-65","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"`numpy.random.<X>` directly"},"924":{"id":"/docs/guides/random-66","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"not counted"},"925":{"id":"/docs/guides/random-67","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#whats-deliberately-not-supported","content":"Use `fnp.random.<X>` for counting. `numpy.random.X` continues to work but bypasses flopscope."},"926":{"id":"/docs/guides/random-68","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#related","content":"`fnp.random.default_rng` — canonical entry point (op page)"},"927":{"id":"/docs/guides/random-69","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#related","content":"Migrate from NumPy — broader migration guide"},"928":{"id":"/docs/guides/random-70","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#related","content":"Issue #18 — design rationale and history"},"929":{"id":"/docs/guides/random-71","page_id":"/docs/guides/random","tags":[],"type":"text","url":"/docs/guides/random#related","content":"(`fnp.random.RandomState` is a class constructor, not a registered op — its\nsampler methods have individual op pages under `/docs/api/numpy/random/`.)"},"930":{"id":"/docs/guides/save-load","page_id":"/docs/guides/save-load","type":"page","content":"Saving & Loading Models","breadcrumbs":["Documentation","Guides"],"tags":[],"url":"/docs/guides/save-load"},"931":{"id":"/docs/guides/save-load-0","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#the-mental-model","content":"The mental model"},"932":{"id":"/docs/guides/save-load-1","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#saving-and-loading-arrays","content":"Saving and loading arrays"},"933":{"id":"/docs/guides/save-load-2","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#custom-models-with-flopsmodule","content":"Custom models with flops.Module"},"934":{"id":"/docs/guides/save-load-3","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"How `state_dict` auto-discovery works"},"935":{"id":"/docs/guides/save-load-4","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#config-and-reconstruction","content":"`config()` and reconstruction"},"936":{"id":"/docs/guides/save-load-5","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#in-place-loading-with-load","content":"In-place loading with `load`"},"937":{"id":"/docs/guides/save-load-6","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#authoring-weight-files-offline","content":"Authoring weight files offline"},"938":{"id":"/docs/guides/save-load-7","page_id":"/docs/guides/save-load","type":"heading","tags":[],"url":"/docs/guides/save-load#faq-why-cant-load-return-my-model-object-directly","content":"FAQ: why can't `load` return my model object directly?"},"939":{"id":"/docs/guides/save-load-8","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load","content":"*Store weights in a portable, pickle-free file. Loading them back is free; saving bills the bytes you write.*"},"940":{"id":"/docs/guides/save-load-9","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load","content":"**You will learn:**"},"941":{"id":"/docs/guides/save-load-10","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load","content":"What a flopscope file contains and why it is safe to load"},"942":{"id":"/docs/guides/save-load-11","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load","content":"How to save and load individual arrays with `fnp.save`/`fnp.savez`/`fnp.load`"},"943":{"id":"/docs/guides/save-load-12","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load","content":"How to build a custom model with `flops.Module` and round-trip it through a file"},"944":{"id":"/docs/guides/save-load-13","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load","content":"How to prepare weight files offline with plain NumPy and load them during the challenge run"},"945":{"id":"/docs/guides/save-load-14","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#the-mental-model","content":"A flopscope file stores exactly two things:"},"946":{"id":"/docs/guides/save-load-15","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#the-mental-model","content":"**Named numeric arrays** — floating-point, integer, bool, or complex; no object dtype."},"947":{"id":"/docs/guides/save-load-16","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#the-mental-model","content":"**An inert JSON `__meta__` block** — plain key/value data, never executed."},"948":{"id":"/docs/guides/save-load-17","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#the-mental-model","content":"Your *class* always lives in *your code*, never in the file. flopscope reads the numeric payload and hands the values to the object you construct — no pickle, no `eval`, no `exec`. That boundary is the entire security model: loading a file can never execute code."},"949":{"id":"/docs/guides/save-load-18","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#the-mental-model","content":"Loading is **free**: `fnp.load` charges 0 FLOPs regardless of file size. Saving is\nnot — `fnp.save`, `fnp.savez`, and `fnp.savez_compressed` each charge 4 FLOPs per\nelement written, plus 4 FLOPs per byte of the array names themselves and of a\nserialized `__meta__` block, so there is no free way to smuggle data through any of\nthose channels."},"950":{"id":"/docs/guides/save-load-19","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#saving-and-loading-arrays","content":"Use `fnp.savez` to write multiple named arrays into a single `.npz` file:"},"951":{"id":"/docs/guides/save-load-20","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#saving-and-loading-arrays","content":"Load them back with `fnp.load`, which returns a plain `dict`:"},"952":{"id":"/docs/guides/save-load-21","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#saving-and-loading-arrays","content":"For a single array, use the `.npy` variants:"},"953":{"id":"/docs/guides/save-load-22","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#saving-and-loading-arrays","content":"Use `fnp.savez_compressed` when file size matters — it writes the same format as\n`fnp.savez` but with lossless compression:"},"954":{"id":"/docs/guides/save-load-23","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#saving-and-loading-arrays","content":"> **Note:** flopscope refuses `object` dtype everywhere, not just at save —\n> building one with `fnp.array(..., dtype=object)` already raises\n> `UnsupportedDtypeError`. See the object-dtype note in the FLOP counting\n> model. The file format itself\n> accepts only numeric dtypes (float, int, bool, complex); `str_`, `bytes_`,\n> `datetime64`, `timedelta64`, and structured dtypes are rejected by `save`\n> with a `ValueError` even though they are billable everywhere else."},"955":{"id":"/docs/guides/save-load-24","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#custom-models-with-flopsmodule","content":"For whole models, `flops.Module` auto-discovers every array attribute and\nnested sub-module, so you never write a manual save loop."},"956":{"id":"/docs/guides/save-load-25","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"`flops.Module.state_dict()` walks `vars(self)` and collects:"},"957":{"id":"/docs/guides/save-load-26","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"Attribute type"},"958":{"id":"/docs/guides/save-load-27","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"How it is collected"},"959":{"id":"/docs/guides/save-load-28","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"`FlopscopeArray`"},"960":{"id":"/docs/guides/save-load-29","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"stored directly under the attribute name"},"961":{"id":"/docs/guides/save-load-30","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"Nested `flops.Module`"},"962":{"id":"/docs/guides/save-load-31","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"recursed with a dotted prefix (`layers.0.W`)"},"963":{"id":"/docs/guides/save-load-32","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"`list` / `tuple` of the above"},"964":{"id":"/docs/guides/save-load-33","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"indexed as `layers.0`, `layers.1`, …"},"965":{"id":"/docs/guides/save-load-34","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"`dict` of the above"},"966":{"id":"/docs/guides/save-load-35","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"keyed as `config.key`"},"967":{"id":"/docs/guides/save-load-36","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"Attributes starting with `_`"},"968":{"id":"/docs/guides/save-load-37","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"**skipped**"},"969":{"id":"/docs/guides/save-load-38","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"Everything else (scalars, strings, …)"},"970":{"id":"/docs/guides/save-load-39","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#how-state_dict-auto-discovery-works","content":"**skipped**"},"971":{"id":"/docs/guides/save-load-40","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#config-and-reconstruction","content":"Override `config()` to return the keyword arguments that `__init__` needs to\nreconstruct your model with the right shapes. `from_file` passes them verbatim:"},"972":{"id":"/docs/guides/save-load-41","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#in-place-loading-with-load","content":"If you already have a model with the right architecture, call `load` to update\nits weights in place:"},"973":{"id":"/docs/guides/save-load-42","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#authoring-weight-files-offline","content":"You can prepare weight files in your regular development environment (real NumPy,\nGPU frameworks, etc.) and load them inside the budgeted competition run:"},"974":{"id":"/docs/guides/save-load-43","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#authoring-weight-files-offline","content":"`fnp.load` reads files written by plain `numpy.save`/`numpy.savez` without any\nformat conversion. The only constraint is that the arrays must be numeric dtype."},"975":{"id":"/docs/guides/save-load-44","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#faq-why-cant-load-return-my-model-object-directly","content":"Returning a live model object from a file would require encoding the *class* into\nthe file. The only general way to do that is pickle — and pickle can execute\narbitrary code at load time. flopscope deliberately avoids this."},"976":{"id":"/docs/guides/save-load-45","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#faq-why-cant-load-return-my-model-object-directly","content":"Instead, the class always comes from *your code*:"},"977":{"id":"/docs/guides/save-load-46","page_id":"/docs/guides/save-load","tags":[],"type":"text","url":"/docs/guides/save-load#faq-why-cant-load-return-my-model-object-directly","content":"`from_file` is a class method: you call it on `MLP`, so Python already knows\nthe class. The file only supplies the weights (numeric arrays) and the\nJSON config. No code ever travels through the file."},"978":{"id":"/docs/guides/symmetry","page_id":"/docs/guides/symmetry","type":"page","content":"Symmetry Savings","breadcrumbs":["Documentation","Guides"],"tags":[],"url":"/docs/guides/symmetry"},"979":{"id":"/docs/guides/symmetry-0","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#why-symmetry-matters","content":"Why symmetry matters"},"980":{"id":"/docs/guides/symmetry-1","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#quick-start","content":"Quick start"},"981":{"id":"/docs/guides/symmetry-2","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#how-to-declare-symmetry","content":"How to declare symmetry"},"982":{"id":"/docs/guides/symmetry-3","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#full-symmetry-with-symmetrygroupsymmetric","content":"Full symmetry with `SymmetryGroup.symmetric`"},"983":{"id":"/docs/guides/symmetry-4","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#multiple-independent-full-symmetric-groups","content":"Multiple independent full symmetric groups"},"984":{"id":"/docs/guides/symmetry-5","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#explicit-full-symmetric-groups-with-symmetrygroupsymmetric","content":"Explicit full symmetric groups with `SymmetryGroup.symmetric`"},"985":{"id":"/docs/guides/symmetry-6","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#cyclic-symmetry-with-symmetrygroupcyclic","content":"Cyclic symmetry with `SymmetryGroup.cyclic`"},"986":{"id":"/docs/guides/symmetry-7","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#dihedral-symmetry-with-symmetrygroupdihedral","content":"Dihedral symmetry with `SymmetryGroup.dihedral`"},"987":{"id":"/docs/guides/symmetry-8","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#arbitrary-subgroups-from-custom-generators","content":"Arbitrary subgroups from custom generators"},"988":{"id":"/docs/guides/symmetry-9","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#multiple-explicit-groups-on-one-tensor","content":"Multiple explicit groups on one tensor"},"989":{"id":"/docs/guides/symmetry-10","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"Generating example data with the Reynolds operator"},"990":{"id":"/docs/guides/symmetry-11","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"Symmetry propagation at a glance"},"991":{"id":"/docs/guides/symmetry-12","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#slicing-rules","content":"Slicing rules"},"992":{"id":"/docs/guides/symmetry-13","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#reduction-rules","content":"Reduction rules"},"993":{"id":"/docs/guides/symmetry-14","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"Binary pointwise ops and broadcasting"},"994":{"id":"/docs/guides/symmetry-15","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#warnings-conservative-behavior-and-re-tagging","content":"Warnings, conservative behavior, and re-tagging"},"995":{"id":"/docs/guides/symmetry-16","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#edge-cases-when-symmetrictensors-meet-numpy-protocols","content":"Edge cases when SymmetricTensors meet NumPy protocols"},"996":{"id":"/docs/guides/symmetry-17","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#in-place-dunders-refuse-symmetry-corrupting-writes","content":"In-place dunders refuse symmetry-corrupting writes"},"997":{"id":"/docs/guides/symmetry-18","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#in-place-sort--partition-refuse-on-symmetrictensor","content":"In-place sort / partition refuse on SymmetricTensor"},"998":{"id":"/docs/guides/symmetry-19","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#ufuncat-refuses-on-symmetrictensor","content":"`ufunc.at` refuses on SymmetricTensor"},"999":{"id":"/docs/guides/symmetry-20","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#ufuncouter-produces-direct-product-symmetry","content":"`ufunc.outer` produces direct-product symmetry"},"1000":{"id":"/docs/guides/symmetry-21","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#tensordot-keeps-surviving-direct-product-symmetry","content":"`tensordot` keeps surviving direct-product symmetry"},"1001":{"id":"/docs/guides/symmetry-22","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#multi-output-ufuncs-preserve-symmetry-on-every-output","content":"Multi-output ufuncs preserve symmetry on every output"},"1002":{"id":"/docs/guides/symmetry-23","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"Cost model is a placeholder above the `dimino_budget` group order"},"1003":{"id":"/docs/guides/symmetry-24","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#under-the-hood","content":"Under the hood"},"1004":{"id":"/docs/guides/symmetry-25","page_id":"/docs/guides/symmetry","type":"heading","tags":[],"url":"/docs/guides/symmetry#going-deeper","content":"Going deeper"},"1005":{"id":"/docs/guides/symmetry-26","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"*Reduce FLOP costs when your tensors have symmetry.*"},"1006":{"id":"/docs/guides/symmetry-27","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"**You will learn:**"},"1007":{"id":"/docs/guides/symmetry-28","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"How to declare full and non-full tensor symmetries with `flops.as_symmetric()`"},"1008":{"id":"/docs/guides/symmetry-29","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"How to generate example tensors for arbitrary permutation groups"},"1009":{"id":"/docs/guides/symmetry-30","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"When to use `fnp.random.symmetric()` (sample + project) versus `flops.symmetrize()`\n(project existing data)"},"1010":{"id":"/docs/guides/symmetry-31","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"How slicing, reductions, and binary pointwise ops preserve, weaken, or drop symmetry metadata"},"1011":{"id":"/docs/guides/symmetry-32","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"When to re-tag results with `flops.as_symmetric()` after conservative propagation"},"1012":{"id":"/docs/guides/symmetry-33","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry","content":"> For the underlying mental model — orbits, unique work items, why these savings exist — see Symmetry-aware FLOP counting."},"1013":{"id":"/docs/guides/symmetry-34","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"Many tensors contain repeated structure. A symmetric matrix has only\n`n * (n + 1) / 2` unique elements instead of `n^2`, and higher-order tensors\nwith permutation symmetry can shrink the effective element count even more.\nWhen Flopscope knows a tensor's symmetry, it charges FLOPs based on unique elements\ninstead of dense ones."},"1014":{"id":"/docs/guides/symmetry-35","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"Operation"},"1015":{"id":"/docs/guides/symmetry-36","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"Dense cost"},"1016":{"id":"/docs/guides/symmetry-37","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"Symmetry-aware cost"},"1017":{"id":"/docs/guides/symmetry-38","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"Why it drops"},"1018":{"id":"/docs/guides/symmetry-39","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"`fnp.exp(s2_matrix)`"},"1019":{"id":"/docs/guides/symmetry-40","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"`n^2`"},"1020":{"id":"/docs/guides/symmetry-41","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"`n * (n + 1) / 2`"},"1021":{"id":"/docs/guides/symmetry-42","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"only unique matrix entries matter"},"1022":{"id":"/docs/guides/symmetry-43","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"`fnp.einsum('ki,kj->ij', x, x)` with `x` repeated, `m=n=4`"},"1023":{"id":"/docs/guides/symmetry-44","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"128"},"1024":{"id":"/docs/guides/symmetry-45","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"80"},"1025":{"id":"/docs/guides/symmetry-46","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"the repeated `x` operand lets flopscope detect symmetric output and discount accumulations + multiplications"},"1026":{"id":"/docs/guides/symmetry-47","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"`fnp.einsum('i,j,k->ijk', v, v, v)` with `v` repeated, `n=4`"},"1027":{"id":"/docs/guides/symmetry-48","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"192"},"1028":{"id":"/docs/guides/symmetry-49","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"60"},"1029":{"id":"/docs/guides/symmetry-50","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"three identical operands induce an `S₃` action on the output labels"},"1030":{"id":"/docs/guides/symmetry-51","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"`fnp.sum(s3_tensor)` on a fully-symmetric `(4, 4, 4)`"},"1031":{"id":"/docs/guides/symmetry-52","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"63"},"1032":{"id":"/docs/guides/symmetry-53","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"19"},"1033":{"id":"/docs/guides/symmetry-54","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"the same orbit logic applies to reductions, not just einsum"},"1034":{"id":"/docs/guides/symmetry-55","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#why-symmetry-matters","content":"By contrast, declaring `symmetry=` on an `einsum` output tags the result for downstream\noperations; it does not reduce that `einsum`'s own cost by itself."},"1035":{"id":"/docs/guides/symmetry-56","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#quick-start","content":"`flops.as_symmetric()` validates the data first. Validation uses a tolerance,\nwhile the tag it grants is read as exact — the cost model prices every position\nin an orbit after the first as redundant and does not read the buffer again — so\n`as_symmetric` makes the two agree before tagging: each orbit takes the value at\nits lexicographically smallest index. Data that is already exactly invariant is\nreturned unchanged, so a genuinely symmetric array is tagged without being\ncopied; data that passed only within the tolerance is copied first, and the\nvalues in the discarded positions do not survive. Your own array is never\nmodified either way."},"1036":{"id":"/docs/guides/symmetry-57","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#quick-start","content":"After that, Flopscope propagates symmetry metadata algebraically through many\noperations. Unary pointwise ops preserve symmetry-aware costs and keep the same exact group, including non-full groups such as `C_k` or `D_k`. Slicing, reductions, and binary pointwise ops can weaken it or remove it entirely."},"1037":{"id":"/docs/guides/symmetry-58","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#full-symmetry-with-symmetrygroupsymmetric","content":"Use `SymmetryGroup.symmetric` when the tensor is invariant under every permutation of a\nset of axes."},"1038":{"id":"/docs/guides/symmetry-59","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#full-symmetry-with-symmetrygroupsymmetric","content":"This is the most common declaration: full `S_2` symmetry on matrix axes\n`(0, 1)`."},"1039":{"id":"/docs/guides/symmetry-60","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#multiple-independent-full-symmetric-groups","content":"This declares one full symmetric group on axes `(0, 1)` and another on\n`(2, 3)`."},"1040":{"id":"/docs/guides/symmetry-61","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#explicit-full-symmetric-groups-with-symmetrygroupsymmetric","content":"This explicit group is useful once you want to inspect or combine symmetry directly."},"1041":{"id":"/docs/guides/symmetry-62","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cyclic-symmetry-with-symmetrygroupcyclic","content":"`C_3` means rotations are allowed, but reflections are not. This is weaker\nthan `S_3`, so it usually gives fewer savings."},"1042":{"id":"/docs/guides/symmetry-63","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#dihedral-symmetry-with-symmetrygroupdihedral","content":"`D_4` includes both rotations and reflections of a four-position structure."},"1043":{"id":"/docs/guides/symmetry-64","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#arbitrary-subgroups-from-custom-generators","content":"Use this form when the built-in constructors do not describe your symmetry."},"1044":{"id":"/docs/guides/symmetry-65","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#multiple-explicit-groups-on-one-tensor","content":"This uses a direct product of two exact symmetry factors, one on `(0, 1)` and one on `(2, 3)`."},"1045":{"id":"/docs/guides/symmetry-66","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"When you want example tensors for arbitrary groups, prefer `fnp.random.symmetric`.\nIt is a handy helper that samples from a distribution and applies the Reynolds\noperator.\nUse `flops.symmetrize` when you already have concrete data to symmetrize, and\n`flops.as_symmetric` when you already have concrete data to validate and tag."},"1046":{"id":"/docs/guides/symmetry-67","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"`R_G(T) = (1 / |G|) * sum_{g in G} g · T`"},"1047":{"id":"/docs/guides/symmetry-68","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"This helper is ideal for docs, tests, and experiments:"},"1048":{"id":"/docs/guides/symmetry-69","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"it works for `S_k`, `C_k`, `D_k`, and custom generator sets"},"1049":{"id":"/docs/guides/symmetry-70","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"prefer `fnp.random.symmetric()` for synthetic data generation"},"1050":{"id":"/docs/guides/symmetry-71","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"`fnp.random.symmetric` internally samples data and calls `flops.symmetrize` so the\nprojection and validation behavior is identical."},"1051":{"id":"/docs/guides/symmetry-72","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"approximate costs (meaningful estimate), for the default\n`mode=\"reynolds-projection\"`:"},"1052":{"id":"/docs/guides/symmetry-73","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"`fnp.random.symmetric`: `C_dist(n) + |G| * n + n`"},"1053":{"id":"/docs/guides/symmetry-74","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"`flops.symmetrize`: `|G| * n + n`\\\nwith `n` total elements and `|G|` group order. The internal validation\npass is not billed. Reynolds averaging always accumulates in float64, so\n`flops.symmetrize` is charged at the float64 rate whatever the input\ndtype; `mode=\"canonical-copy\"` keeps the input's own rate."},"1054":{"id":"/docs/guides/symmetry-75","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"in exact arithmetic it projects onto the invariant subspace, and in practice\n`flops.as_symmetric()` validates the result with its usual validation tolerances"},"1055":{"id":"/docs/guides/symmetry-76","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"Both functions also accept `mode=\"canonical-copy\"`, which keeps one entry per\norbit — the one at the lexicographically smallest index — instead of averaging\nthe orbit. It replaces the `|G| * n + n` projection term with a single `n`\ncopy pass (so `flops.symmetrize` costs `n`, and `fnp.random.symmetric`\ncosts `C_dist(n) + n`), preserves the input dtype instead of promoting to\nfloat64, and reads only the group's generators, so it stays available for groups\ntoo large to enumerate (see below). It is a different result, not a cheaper\nroute to the same one: the other entries in each orbit are discarded rather than\naveraged in. Reach for it when you want a tensor that *has* the symmetry, and\nfor Reynolds when you want the projection of your data *onto* the invariant\nsubspace."},"1056":{"id":"/docs/guides/symmetry-77","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"it keeps examples consistent across symmetry classes"},"1057":{"id":"/docs/guides/symmetry-78","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#generating-example-data-with-the-reynolds-operator","content":"The propagation examples below assume `import flopscope as flops` plus `import flopscope.numpy as fnp`; generated tensors\nabove use `fnp.random.symmetric(...)` and the explicit transform helper is\n`flops.symmetrize(...)`."},"1058":{"id":"/docs/guides/symmetry-79","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"Symmetry propagation is conservative. Flopscope keeps symmetry metadata only when\nthe operation's structure guarantees that the output still respects the\nsurviving group."},"1059":{"id":"/docs/guides/symmetry-80","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"Operation"},"1060":{"id":"/docs/guides/symmetry-81","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"Result type"},"1061":{"id":"/docs/guides/symmetry-82","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"Rule"},"1062":{"id":"/docs/guides/symmetry-83","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`fnp.exp(s3_tensor)`"},"1063":{"id":"/docs/guides/symmetry-84","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`SymmetricTensor`"},"1064":{"id":"/docs/guides/symmetry-85","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"unary pointwise ops preserve the exact declared group"},"1065":{"id":"/docs/guides/symmetry-86","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`fnp.add(s3_tensor, c3_tensor)`"},"1066":{"id":"/docs/guides/symmetry-87","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`SymmetricTensor` or `FlopscopeArray`"},"1067":{"id":"/docs/guides/symmetry-88","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"binary pointwise ops keep the intersection of both operands' groups"},"1068":{"id":"/docs/guides/symmetry-89","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`s2_matrix * 3`"},"1069":{"id":"/docs/guides/symmetry-90","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`SymmetricTensor`"},"1070":{"id":"/docs/guides/symmetry-91","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"scalar binary ops preserve the tensor's groups"},"1071":{"id":"/docs/guides/symmetry-92","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`s2_matrix[0]`"},"1072":{"id":"/docs/guides/symmetry-93","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`FlopscopeArray`"},"1073":{"id":"/docs/guides/symmetry-94","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"integer indexing removes one axis; no nontrivial group survives"},"1074":{"id":"/docs/guides/symmetry-95","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`s2_matrix[:3, :3]`"},"1075":{"id":"/docs/guides/symmetry-96","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`SymmetricTensor`"},"1076":{"id":"/docs/guides/symmetry-97","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"equal-size slices can preserve symmetry"},"1077":{"id":"/docs/guides/symmetry-98","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`s2_matrix[:3, :2]`"},"1078":{"id":"/docs/guides/symmetry-99","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`FlopscopeArray`"},"1079":{"id":"/docs/guides/symmetry-100","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"unequal-size slices break symmetry between those axes"},"1080":{"id":"/docs/guides/symmetry-101","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`s2_matrix[fnp.array([0, 1])]`"},"1081":{"id":"/docs/guides/symmetry-102","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`FlopscopeArray`"},"1082":{"id":"/docs/guides/symmetry-103","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"advanced indexing drops symmetry conservatively"},"1083":{"id":"/docs/guides/symmetry-104","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`fnp.sum(s3_tensor, axis=0)`"},"1084":{"id":"/docs/guides/symmetry-105","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`SymmetricTensor`"},"1085":{"id":"/docs/guides/symmetry-106","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"reductions keep the surviving setwise stabilizer subgroup"},"1086":{"id":"/docs/guides/symmetry-107","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`fnp.sum(d4_tensor, axis=(1, 3))`"},"1087":{"id":"/docs/guides/symmetry-108","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`SymmetricTensor`"},"1088":{"id":"/docs/guides/symmetry-109","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"reductions can keep a proper subgroup like `C_2`"},"1089":{"id":"/docs/guides/symmetry-110","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`s2_matrix @ s2_matrix`"},"1090":{"id":"/docs/guides/symmetry-111","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`FlopscopeArray`"},"1091":{"id":"/docs/guides/symmetry-112","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"matrix products are not assumed symmetric in general"},"1092":{"id":"/docs/guides/symmetry-113","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#symmetry-propagation-at-a-glance","content":"`fnp.exp(c3_tensor)` keeps the original `C_3` subgroup exactly; the same applies\nto `D_k` and custom exact groups."},"1093":{"id":"/docs/guides/symmetry-114","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"Slicing uses the **pointwise stabilizer** of the removed axes. Informally:\nevery removed axis must stay fixed under any surviving group element."},"1094":{"id":"/docs/guides/symmetry-115","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"What happens here:"},"1095":{"id":"/docs/guides/symmetry-116","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`same_size_slice` stays symmetric because both surviving axes still have the\nsame size"},"1096":{"id":"/docs/guides/symmetry-117","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`different_size_slice` loses symmetry because the two axes no longer match"},"1097":{"id":"/docs/guides/symmetry-118","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`expanded_s2_matrix` keeps the same `S_2` action, but the axes are renumbered\nfrom `(0, 1)` to `(1, 2)`"},"1098":{"id":"/docs/guides/symmetry-119","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`advanced_index_slice` returns a dense `FlopscopeArray`; flopscope does not attempt to\npropagate symmetry through array/list indexing"},"1099":{"id":"/docs/guides/symmetry-120","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`Ellipsis` behaves like NumPy's normal expansion rules. It can change which\naxes remain, but it does not change the propagation rule itself."},"1100":{"id":"/docs/guides/symmetry-121","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"The difference between full and non-full groups matters immediately:"},"1101":{"id":"/docs/guides/symmetry-122","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`s3_slice` keeps an `S_2` subgroup on the surviving axes"},"1102":{"id":"/docs/guides/symmetry-123","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#slicing-rules","content":"`c3_slice` loses all nontrivial symmetry, because `C_3` has no non-identity\nelement that fixes one point"},"1103":{"id":"/docs/guides/symmetry-124","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"Reductions use the **setwise stabilizer** of the reduced axes. Informally:\nreduced axes are allowed to permute among themselves, because summation treats\nall positions along the reduced set equivalently."},"1104":{"id":"/docs/guides/symmetry-125","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"What happens here:"},"1105":{"id":"/docs/guides/symmetry-126","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"`s3_reduced` keeps an `S_2` subgroup on the remaining axes"},"1106":{"id":"/docs/guides/symmetry-127","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"`c3_reduced` loses all nontrivial symmetry"},"1107":{"id":"/docs/guides/symmetry-128","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"`c4_reduced` keeps a `C_2` subgroup"},"1108":{"id":"/docs/guides/symmetry-129","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"`c4_keepdims` keeps the same surviving subgroup, but the output axes stay in\ntheir original tensor positions because `keepdims=True`"},"1109":{"id":"/docs/guides/symmetry-130","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#reduction-rules","content":"Reducing an axis that is not in a symmetry group leaves that group alone, apart\nfrom any axis renumbering caused by the removed dimension."},"1110":{"id":"/docs/guides/symmetry-131","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"Binary pointwise ops keep only the symmetry present in **both** operands. For\ngeneral groups, that means element-set intersection on matching output axes,\nnot just matching tuples of axis numbers."},"1111":{"id":"/docs/guides/symmetry-132","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"`intersection_tensor` keeps `C_3`, because `C_3` is the common subgroup of\n`S_3` and `C_3`."},"1112":{"id":"/docs/guides/symmetry-133","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"Multiple groups are handled independently:"},"1113":{"id":"/docs/guides/symmetry-134","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"`shared_group_tensor` keeps only the swap on `(0, 1)`. In the exact-group\nrepresentation that surviving action is still embedded in the full output rank,\nso the group's support tuple spans `(0, 1, 2, 3)` even though it acts\nnontrivially only on `(0, 1)`."},"1114":{"id":"/docs/guides/symmetry-135","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"Broadcasting matters too:"},"1115":{"id":"/docs/guides/symmetry-136","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#binary-pointwise-ops-and-broadcasting","content":"Before group intersection, any axis stretched from size `1` to a larger output\nsize is removed from the carried candidate group. So singleton broadcasting by\nitself does not preserve symmetry. In this example, though, `plain_tensor`\nalready carries the same analytically provable `S_2` symmetry on `(0, 1)`, so\n`broadcast_sum` keeps that shared block."},"1116":{"id":"/docs/guides/symmetry-137","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#warnings-conservative-behavior-and-re-tagging","content":"Flopscope propagates symmetry metadata conservatively. When the operation does not\nguarantee that the declared symmetry survives, the result falls back to a dense\n`FlopscopeArray` with no `.symmetry` metadata."},"1117":{"id":"/docs/guides/symmetry-138","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#warnings-conservative-behavior-and-re-tagging","content":"`row_slice` is a plain dense `FlopscopeArray`, not a `SymmetricTensor`. That is expected."},"1118":{"id":"/docs/guides/symmetry-139","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#warnings-conservative-behavior-and-re-tagging","content":"`SymmetryLossWarning` tells you that metadata was dropped or weakened during an\noperation. If you know more about the result than the conservative propagation\nrule does, you can re-tag it with `flops.as_symmetric()`."},"1119":{"id":"/docs/guides/symmetry-140","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#warnings-conservative-behavior-and-re-tagging","content":"One important caveat: the current implementation does **not** report every\npossible partial weakening via `SymmetryLossWarning`. Treat the warning system\nas helpful guidance, not as a complete audit of every same-axis subgroup\nchange."},"1120":{"id":"/docs/guides/symmetry-141","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#edge-cases-when-symmetrictensors-meet-numpy-protocols","content":"Once your tensors flow through arbitrary user code (or third-party libraries), they\ninevitably hit NumPy's `__array_ufunc__` and `__array_function__` machinery —\n`np.add(A, B)`, `np.divmod(A, B)`, `np.add.outer(A, B)`, `np.add.at(A, idx, vals)`,\n`A @= B`, `np.tensordot(A, B, axes=...)`, and so on. Flopscope's\nprotocol implementations are conservative: when an operation would silently\ncorrupt your declared symmetry, flopscope **refuses or strips** rather than letting\nit through. This section is a tour of those edge cases."},"1121":{"id":"/docs/guides/symmetry-142","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#in-place-dunders-refuse-symmetry-corrupting-writes","content":"The right-hand-side has no symmetry, so `A_sym + B_plain` returns a plain\n`FlopscopeArray`. Writing that result back into `A_sym`'s buffer would leave the\nmetadata claiming symmetry while the data is asymmetric. Flopscope refuses with\n`ValueError: in-place add on a SymmetricTensor would weaken or destroy the\ndeclared symmetry`."},"1122":{"id":"/docs/guides/symmetry-143","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#in-place-dunders-refuse-symmetry-corrupting-writes","content":"If you know the asymmetric write is intentional, downgrade first:"},"1123":{"id":"/docs/guides/symmetry-144","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#in-place-dunders-refuse-symmetry-corrupting-writes","content":"The same guard applies to `__isub__`, `__imul__`, `__itruediv__`,\n`__ifloordiv__`, `__imod__`, `__ipow__`, `__iand__`, `__ior__`, `__ixor__`,\n`__ilshift__`, `__irshift__`, and `__imatmul__` (which additionally falls back\nto CPython's rebind-the-name semantics when the matmul output shape differs\nfrom `self.shape`)."},"1124":{"id":"/docs/guides/symmetry-145","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#in-place-sort--partition-refuse-on-symmetrictensor","content":"A reorder along any axis breaks the permutation invariance. Use the out-of-place\nforms instead:"},"1125":{"id":"/docs/guides/symmetry-146","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#ufuncat-refuses-on-symmetrictensor","content":"`np.add.at(a, indices, values)` does an unbuffered fancy-index write — every\nrepeat of an index applies again (unlike `a[indices] += values` which dedupes).\nOn a `SymmetricTensor` this almost certainly breaks symmetry, so flopscope\nrefuses:"},"1126":{"id":"/docs/guides/symmetry-147","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#ufuncat-refuses-on-symmetrictensor","content":"Downgrade with `A_sym.view(fnp.ndarray)` first if you really need the unbuffered\nupdate."},"1127":{"id":"/docs/guides/symmetry-148","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#ufuncouter-produces-direct-product-symmetry","content":"When both operands are symmetric, the output of `np.<ufunc>.outer(A, B)`\ninherits the **direct product** of the input symmetries — `A`'s symmetry on\nits own axes, `B`'s symmetry on the lifted slots `A.ndim..A.ndim+B.ndim-1`:"},"1128":{"id":"/docs/guides/symmetry-149","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#tensordot-keeps-surviving-direct-product-symmetry","content":"The contracted axes drop out of each operand's symmetry; what's left of each\noperand's symmetry on the surviving (uncontracted) axes is direct-producted:"},"1129":{"id":"/docs/guides/symmetry-150","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#tensordot-keeps-surviving-direct-product-symmetry","content":"If the contracted axis is part of the symmetry group, that group is destroyed\non the corresponding side."},"1130":{"id":"/docs/guides/symmetry-151","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#multi-output-ufuncs-preserve-symmetry-on-every-output","content":"`np.divmod(A, B)`, `np.frexp(A)`, `np.modf(A)` are elementwise — both outputs\ninherit the same symmetry as their inputs:"},"1131":{"id":"/docs/guides/symmetry-152","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#multi-output-ufuncs-preserve-symmetry-on-every-output","content":"`out=(o1, o2)` works (per-slot identity is preserved), and `out=(o1, None)`\nlets numpy allocate just the second slot."},"1132":{"id":"/docs/guides/symmetry-153","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"Flopscope charges `dense_cost × unique_output_elements / dense_output_elements` for\n`ufunc.outer` and `tensordot` as a coarse proxy for the savings a\nsymmetry-aware implementation could realise. The underlying NumPy call still\ndoes dense work; only the budget reflects the savings."},"1133":{"id":"/docs/guides/symmetry-154","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"For a `SymmetryGroup` whose order `|G|` exceeds the configured `dimino_budget`\n(default **50,000** — accepts up to `|S_8| = 40,320` with a small margin),\nflopscope skips this adjustment and charges the full dense cost. Burnside\nenumeration on the group would otherwise iterate every element. The skip is\nannounced via `CostFallbackWarning`:"},"1134":{"id":"/docs/guides/symmetry-155","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"This is rare in practice — common user tensors have small group orders — but\nhigh-rank auto-inferred symmetries on degenerate shapes (`(1,)*N` for large `N`)\ntrip the cap. The warning fires once per `(op_name, |G|)` pair per process to\navoid log flooding. Suppress with `flops.configure(symmetry_warnings=False)`,\nwhich shares the flag with `SymmetryLossWarning`."},"1135":{"id":"/docs/guides/symmetry-156","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"`flops.symmetrize` and `fnp.random.symmetric` are the exception to the\ndegrade-and-continue behaviour above: for them, enumerating the group *is* the\ncomputation, so there is no dense cost to fall back to. Above the budget they\nraise `ValueError` rather than warn, and the refused call is not charged. Use\n`mode=\"canonical-copy\"`, which reads the generators alone and never enumerates\nthe group:"},"1136":{"id":"/docs/guides/symmetry-157","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"The gate keys on `|G|` rather than degree because `|G|` is the actual driver\nof enumeration cost. A high-degree but small-order group like\n`SymmetryGroup.cyclic(axes=tuple(range(50)))` (degree 50, `|G| = 50`) passes\nthe gate easily, whereas `SymmetryGroup.symmetric(axes=tuple(range(9)))`\n(degree 9, `|G| = 362,880`) bails. For known group families\n(`symmetric`, `cyclic`, `dihedral`, `young`, `direct_product`) `order()` is\nclosed-form O(1), so the check itself never enumerates. Tune the budget with\n`flops.configure(dimino_budget=...)`, or run\n`python -m benchmarks._perm_group_calibration` for a recommendation tied to\nyour host machine."},"1137":{"id":"/docs/guides/symmetry-158","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#cost-model-is-a-placeholder-above-the-dimino_budget-group-order","content":"A proper algorithmic-cost model is a follow-up."},"1138":{"id":"/docs/guides/symmetry-159","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"The propagation rules are easier to predict if you keep three ideas in mind:"},"1139":{"id":"/docs/guides/symmetry-160","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"**Unary pointwise ops** preserve symmetry-aware costs, but for\nfull and non-full groups alike they keep the same exact group"},"1140":{"id":"/docs/guides/symmetry-161","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"**Slicing** uses the pointwise stabilizer of the removed axes"},"1141":{"id":"/docs/guides/symmetry-162","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"**Reductions** use the setwise stabilizer of the reduced axes"},"1142":{"id":"/docs/guides/symmetry-163","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"**Binary pointwise ops** use intersection of both operands' groups after\nbroadcast alignment"},"1143":{"id":"/docs/guides/symmetry-164","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"After computing the surviving subgroup, flopscope restricts it to the axes still\npresent in the output and remaps those axes to the output tensor's numbering."},"1144":{"id":"/docs/guides/symmetry-165","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"That is why:"},"1145":{"id":"/docs/guides/symmetry-166","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"slicing one axis of `S_3` leaves `S_2`"},"1146":{"id":"/docs/guides/symmetry-167","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"slicing one axis of `C_3` leaves nothing nontrivial"},"1147":{"id":"/docs/guides/symmetry-168","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#under-the-hood","content":"reducing `{1, 3}` of `C_4` can still leave `C_2`"},"1148":{"id":"/docs/guides/symmetry-169","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#going-deeper","content":"Einsum Patterns — how declared and induced symmetry interact with `fnp.einsum`"},"1149":{"id":"/docs/guides/symmetry-170","page_id":"/docs/guides/symmetry","tags":[],"type":"text","url":"/docs/guides/symmetry#going-deeper","content":"Symmetry Detection Deep Dive — the full detection algorithm for `einsum`"},"1150":{"id":"/docs/infrastructure/client-server","page_id":"/docs/infrastructure/client-server","type":"page","content":"Client-Server Model","breadcrumbs":["Documentation","Infrastructure"],"tags":[],"url":"/docs/infrastructure/client-server"},"1151":{"id":"/docs/infrastructure/client-server-0","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#why-client-server","content":"Why client-server?"},"1152":{"id":"/docs/infrastructure/client-server-1","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#how-it-works","content":"How it works"},"1153":{"id":"/docs/infrastructure/client-server-2","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#communication-protocol","content":"Communication protocol"},"1154":{"id":"/docs/infrastructure/client-server-3","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"Authoritative budget summaries"},"1155":{"id":"/docs/infrastructure/client-server-4","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#api-compatibility","content":"API compatibility"},"1156":{"id":"/docs/infrastructure/client-server-5","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#when-to-use-which","content":"When to use which"},"1157":{"id":"/docs/infrastructure/client-server-6","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"Three packages in this repo"},"1158":{"id":"/docs/infrastructure/client-server-7","page_id":"/docs/infrastructure/client-server","type":"heading","tags":[],"url":"/docs/infrastructure/client-server#related-pages","content":"Related pages"},"1159":{"id":"/docs/infrastructure/client-server-8","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server","content":"This page covers the client-server architecture used for **competition evaluation**, where participant code runs in an isolated container. For how Flopscope wraps NumPy internally, see How Flopscope Works."},"1160":{"id":"/docs/infrastructure/client-server-9","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server","content":"*Use this page to understand how Flopscope's client-server architecture works and why it exists.*"},"1161":{"id":"/docs/infrastructure/client-server-10","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server","content":"**You will learn:**"},"1162":{"id":"/docs/infrastructure/client-server-11","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server","content":"Why Flopscope uses a client-server model for competition evaluation"},"1163":{"id":"/docs/infrastructure/client-server-12","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server","content":"How arrays, operations, and budgets flow between client and server"},"1164":{"id":"/docs/infrastructure/client-server-13","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server","content":"How to choose between the local library and client-server packages"},"1165":{"id":"/docs/infrastructure/client-server-14","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#why-client-server","content":"In competition evaluation, participant code runs in an **isolated container** that cannot import NumPy directly. This prevents participants from bypassing FLOP counting by calling NumPy functions outside flopscope."},"1166":{"id":"/docs/infrastructure/client-server-15","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#why-client-server","content":"The client-server model enforces this isolation:"},"1167":{"id":"/docs/infrastructure/client-server-16","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#how-it-works","content":"**Server** runs the real flopscope library backed by NumPy. It stores all arrays, enforces budgets, and counts FLOPs."},"1168":{"id":"/docs/infrastructure/client-server-17","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#how-it-works","content":"**Client** exposes the same public imports (`import flopscope as flops` plus `import flopscope.numpy as fnp`) and proxies every operation to the server over ZMQ (msgpack-encoded messages)."},"1169":{"id":"/docs/infrastructure/client-server-18","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#how-it-works","content":"**Arrays stay on the server.** The client holds lightweight `RemoteArray` handles that reference server-side data. When you call `fnp.einsum(...)`, the client sends the operation and handle IDs to the server, which executes it and returns a new handle."},"1170":{"id":"/docs/infrastructure/client-server-19","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#how-it-works","content":"**Budget enforcement happens server-side.** The client cannot manipulate FLOP counts."},"1171":{"id":"/docs/infrastructure/client-server-20","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#communication-protocol","content":"**Transport:** ZMQ (REQ/REP pattern)"},"1172":{"id":"/docs/infrastructure/client-server-21","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#communication-protocol","content":"**Serialization:** msgpack with binary-safe array payloads"},"1173":{"id":"/docs/infrastructure/client-server-22","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#communication-protocol","content":"**Default endpoint:** `ipc:///tmp/flopscope.sock` (configurable via `FLOPSCOPE_SERVER_URL`)"},"1174":{"id":"/docs/infrastructure/client-server-23","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#communication-protocol","content":"**Timeout:** 30 seconds per request"},"1175":{"id":"/docs/infrastructure/client-server-24","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"Local and remote summary dictionaries have the same public schema and\naccounting meaning. Remote summaries are read-only snapshots of authoritative\nserver state. The global remote view is the current server summary epoch.\nUnsupported peers raise an actionable capability error rather than returning\npartial or zero-filled data."},"1176":{"id":"/docs/infrastructure/client-server-25","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"The one-participant-process epoch is a WHEST evaluator deployment contract. A\nconforming evaluator must launch the server with `--token-fd`, retain the minted\ntoken in its trusted control channel, perform a post-smoke, pre-scoring reset,\nand couple server replacement to participant-process replacement. Under that\ncontract, smoke work is excluded and participant code cannot reset the epoch\nbecause it never receives the token. A standalone tokenless local/development\nserver intentionally permits lifecycle control operations and is not a hardened\nparticipant boundary."},"1177":{"id":"/docs/infrastructure/client-server-26","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"The server builds a summary in `O(K)` time for the returned operation and\noptional namespace buckets, independent of historical call count. Flat and\nnamespaced requests have identical totals; `by_namespace=True` adds only the\nnamespace mapping. Plain and Rich `budget_summary()` output render the same\nmapping returned by `budget_summary_dict()`."},"1178":{"id":"/docs/infrastructure/client-server-27","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"A summary call's measured inspection overhead is committed after its snapshot\nand appears in the next snapshot or a later final-close snapshot. A final close\nresponse cannot include its own post-boundary serialization recursively."},"1179":{"id":"/docs/infrastructure/client-server-28","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"`BudgetContext.summary_dict()` returns the canonical empty mapping before first\nentry, performs an authoritative resource RPC while live, and returns a\ndefensive copy of its cached final mapping after close. Live scalar timing\nproperties deliberately preserve their established `None`/zero-until-close\nbehavior. After close, all scalar timing properties are read from that same\ncached mapping."},"1180":{"id":"/docs/infrastructure/client-server-29","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#authoritative-budget-summaries","content":"Global `budget_summary_dict()`/`budget_summary()` returns the unchanged\nauthoritative server snapshot. A client-owned `BudgetContext` preserves its\nexisting end-to-end timing meaning by replacing only the four top-level timing\nfields with a decomposition of library-owned local wall/dispatch spans and the\nserver's cumulative compute metadata. The closed scalar timing properties are\nread from that same mapping, so the two public views cannot diverge. These\nclient-only measurements are never sent to the server, cannot alter FLOPs,\noperations, namespaces, budgets, the session summary, or scoring, and are not\nparticipant claims accepted by the authority."},"1181":{"id":"/docs/infrastructure/client-server-30","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#api-compatibility","content":"Code written for the local library works unchanged with the client:"},"1182":{"id":"/docs/infrastructure/client-server-31","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"Use case"},"1183":{"id":"/docs/infrastructure/client-server-32","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"Package"},"1184":{"id":"/docs/infrastructure/client-server-33","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"Install path"},"1185":{"id":"/docs/infrastructure/client-server-34","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"Development, testing, research"},"1186":{"id":"/docs/infrastructure/client-server-35","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"`flopscope` (local library)"},"1187":{"id":"/docs/infrastructure/client-server-36","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"`uv add flopscope` (or `uv sync` from repo for dev)"},"1188":{"id":"/docs/infrastructure/client-server-37","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"Competition evaluation, sandboxed environments"},"1189":{"id":"/docs/infrastructure/client-server-38","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"`flopscope-client` + `flopscope-server`"},"1190":{"id":"/docs/infrastructure/client-server-39","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#when-to-use-which","content":"Docker containers"},"1191":{"id":"/docs/infrastructure/client-server-40","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"Package"},"1192":{"id":"/docs/infrastructure/client-server-41","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"Location"},"1193":{"id":"/docs/infrastructure/client-server-42","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"Description"},"1194":{"id":"/docs/infrastructure/client-server-43","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"`flopscope`"},"1195":{"id":"/docs/infrastructure/client-server-44","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"`src/flopscope/`"},"1196":{"id":"/docs/infrastructure/client-server-45","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"Local library — full NumPy backend, direct execution"},"1197":{"id":"/docs/infrastructure/client-server-46","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"`flopscope-client`"},"1198":{"id":"/docs/infrastructure/client-server-47","page_id":"/docs/infrastructure/client-server","tags":[],"type":"text","url":"/docs/infrastructure/client-server#three-packages-in-this-repo","content":"`flopscope-client/`"},"1199":{"id":"/docs/infrastructure/client-server-48","page_id":"/docs/infrastructure/client-server","tags":[],"type":"tex